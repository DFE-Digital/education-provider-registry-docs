        "headers": {
          "API-Version": {
            "schema": {
              "type": "string"
            }
          },
          "API-Status": {
            "schema": {
              "type": "string",
              "enum": [
                "beta"
              ]
            }
          },
          "X-Request-ID": {
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          "Data-Last-Refreshed-At": {
            "description": "Latest known refresh, when available.",
