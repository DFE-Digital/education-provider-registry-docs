    },
    "schemas": {
      "Establishment": {
        "$ref": "../published-establishment-api.openapi.json#/definitions/Establishment"
      },
      "EstablishmentType": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "name"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[0-9]{2}$",
            "example": "01"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "example": "Community school"
          }
        }
      },
      "EstablishmentPage": {
        "additionalProperties": false,
        "properties": {
          "hasNextPage": {
            "type": "boolean"
          },
          "next": {
            "description": "Relative next-page URL with status and establishmenttype filters preserved, or null on the final page.",
            "type": "string",
            "nullable": true
          },
          "pageSize": {
            "maximum": 10000,
            "type": "integer",
            "minimum": 1
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/Establishment"
            },
            "type": "array"
          }
        },
        "type": "object",
        "required": [
