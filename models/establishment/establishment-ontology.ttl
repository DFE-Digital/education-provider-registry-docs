esto:hasPupilsEducatedByOtherProviders
    a owl:ObjectProperty ;
    rdfs:label "has pupils educated by other providers"@en ;
    rdfs:domain est:PupilReferralUnitOperationalRecord ;
    rdfs:range est:PupilsEducatedByOtherProviders ;
    rdfs:comment "Cardinality: 0..1. Whether the PRU has pupils educated by other providers."@en .


