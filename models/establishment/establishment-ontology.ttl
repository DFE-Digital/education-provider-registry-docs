esto:recordsDateOfNextInspectionVisit
    a owl:ObjectProperty ;
    rdfs:label "records date of next inspection visit"@en ;
    rdfs:domain est:InspectionReportReference ;
    rdfs:range est:DateOfNextInspectionVisit ;
    rdfs:comment "Cardinality: 0..1. Observed for British schools overseas (type 37)."@en .

esto:recordsInspectorateReport
    a owl:ObjectProperty ;
