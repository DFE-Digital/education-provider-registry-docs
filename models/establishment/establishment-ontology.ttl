@prefix est:     <https://dfe-digital.github.io/education-provider-registry-docs/models/establishment/vocabulary/> .
@prefix esto:    <https://dfe-digital.github.io/education-provider-registry-docs/models/establishment/ontology/> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix vann:    <http://purl.org/vocab/vann/> .

# Education Provider Registry Ontology
#
# Scope: this OWL ontology expresses the first conceptual model slice for the
# Education Provider Registry data prototype. It covers the public GIAS
# Details view for the currently modelled establishment examples.
#
# It declares classes and object properties that correspond directly to the
# entities and relationships shown in the Education Provider Registry data model.
# Class IRIs reuse the shared est: namespace so that vocabulary concepts and
# ontology classes are the same resolvable URI.
#
#
# It sits alongside the vocabulary and taxonomy:
#   establishment-vocabulary.ttl
#   establishment-taxonomy.ttl


#################################################################
# Ontology declaration
#################################################################

esto:establishmentDetailsConceptualModel
    a owl:Ontology ;
    dcterms:title "Education Provider Registry Ontology"@en ;
    dcterms:description "OWL 2 conceptual model for the Education Provider Registry. Declares classes and object properties for the entities and relationships in the Education Provider Registry data model."@en ;
    rdfs:comment "This ontology defines the classes and object properties for the Education Provider Registry (EPR) data model. It covers establishment identity and identifiers, lifecycle, classification, accountability, education provision, capacity measures, faith context, SEN and resourced provision, and external references. Class IRIs are shared with the SKOS vocabulary so that vocabulary concepts and ontology classes resolve to the same URI. Object properties are defined in the /ontology/ namespace."@en ;
    dcterms:created "2026-06-18"^^xsd:date ;
    dcterms:modified "2026-07-01"^^xsd:date ;
    dcterms:publisher "Department for Education"@en ;
    dcterms:license <https://www.nationalarchives.gov.uk/doc/open-government-licence/version/3/> ;
    owl:versionInfo "1.11" ;
    vann:preferredNamespacePrefix "epro" ;
    vann:preferredNamespaceUri "https://dfe-digital.github.io/education-provider-registry-docs/models/establishment/ontology/"^^xsd:anyURI ;
    rdfs:seeAlso <https://dfe-digital.github.io/education-provider-registry-docs/models/establishment/vocabulary/> ;
    rdfs:seeAlso <https://dfe-digital.github.io/education-provider-registry-docs/models/establishment/taxonomy/> ;
    rdfs:seeAlso <https://dfe-digital.github.io/education-provider-registry-docs/shapes/> ;
    rdfs:seeAlso <https://dfe-digital.github.io/education-provider-registry-docs/shapes/data-quality/> ;
    rdfs:comment "v0.2: per-type field-applicability rules added as SHACL shapes in establishment-shacl.ttl. Accountability relationship rules (which types require LA, academy trust or proprietor) are now expressed in those shapes rather than as open questions."@en ;
    rdfs:comment "v0.4: field-coverage additions - classes and properties for Ofsted inspection record, PRU operational record, accreditation record (online providers), provider type, manager, academy sponsor SHACL modelling. Ontology already had faith-context classes (ReligiousCharacter, ReligiousEthos, Diocese) and SpecialClassProvision. New additions: OfstedInspectionRecord, PupilReferralUnitOperationalRecord, AccreditationRecord, ProviderType, Manager."@en ;
    rdfs:comment "v0.5: establishment type class hierarchy added. Each GIAS establishment type is now an OWL class subtype of est:Establishment, via intermediate group classes (LaMaintainedSchool, Academy, FreeSchoolEstablishment etc.). Intermediate classes defined here; leaf type classes enriched with owl:Class and rdfs:subClassOf in the taxonomy TTL using OWL 2 punning."@en ;
    rdfs:comment "v0.7: leaf type OWL class declarations moved from the taxonomy TTL into this ontology TTL. The taxonomy TTL is now pure SKOS (skos:Concept, skos:broader etc.). OWL punning is preserved - the same est: URIs remain valid SKOS concepts in the taxonomy. WIDOCO now receives only this ontology TTL, eliminating the skos:Concept hub node from the WebVOWL graph."@en ;
    rdfs:comment "v0.8: owl:NamedIndividual declarations added for 8 closed enumerations (31 individuals total): EstablishmentStatus, EducationPhase, AdmissionsPolicy, GenderOfEntry, BoardingProvision, NurseryProvision, SixthFormProvision, SpecialClassProvision. Open-ended value sets (ReligiousCharacter, ReligiousEthos, TypeOfSenProvision) remain as skos:Concept in the vocabulary TTL only."@en ;
    rdfs:comment "v0.9: PupilReferralUnitOperationalRecord and AccreditationRecord property declarations converted from owl:DatatypeProperty (xsd:boolean/integer/date/string/anyURI ranges) to owl:ObjectProperty with named est: range classes (15 new classes). Ontology is now entirely ObjectProperty - no DatatypeProperty declarations remain."@en ;
    rdfs:comment "v1.0: Identifier modelling tightened. (1) hasUprn domain moved from EstablishmentIdentity to MainAddress. (2) FeHeIdentifier added as OWL class with hasFeHeIdentifier property. (3) hasEstablishmentNumber replaced by LocalAuthorityScopedEstablishmentNumber with hasLocalAuthorityContext, hasEstablishmentNumberValue and hasIdentifierRole components. (4) IdentifierRole added with CurrentIdentifierRole and PreviousIdentifierRole named individuals. (5) EstablishmentNumber value SHACL (1-9999) and UKPRN structural max-1 added."@en ;
    rdfs:comment "v1.1: Establishment group model added. New abstract group superclass EstablishmentGroup; MultiAcademyTrust (subClassOf AcademyTrust), SecureSingleAcademyTrust (subClassOf SingleAcademyTrust), Federation, SchoolSponsor, ChildrensCentreGroup, ChildrensCentreCollaboration, GenericTrust (group org classes); GroupMembership, GroupRelationship, GroupRelationshipType, GroupId, GroupUkprn. AcademyTrust gains dual inheritance: rdfs:subClassOf EstablishmentGroup in addition to existing accountability hierarchy. Named individuals SuccessorMultiAcademyTrust and PredecessorSingleAcademyTrust added for GroupRelationshipType."@en ;
    rdfs:comment "v1.2: Governance model added. 8 new OWL classes: GovernanceAppointment, GovernanceIdentifier, GovernanceRoleType, GovernanceAppointmentDate, GovernanceTermEndDate, GovernanceAppointingBody, GovernancePerson, GovernancePersonIdentifier. 9 new object properties: hasGovernanceAppointment (domain Establishment), hasGroupGovernanceAppointment (domain EstablishmentGroup; AcademyTrust-only enforced in SHACL), hasGovernanceIdentifier, hasGovernanceRoleType, hasGovernanceAppointmentDate, hasGovernanceTermEndDate, hasGovernanceAppointingBody, appointmentOf, hasGovernancePersonIdentifier. 22 named individuals for GovernanceRoleType; 18 for GovernanceAppointingBody. GovernanceAppointment and GovernancePerson annotated with dcterms:accessRights as personal-data-carrying classes."@en ;
    rdfs:comment "v1.3: Administrative geography model added. New class est:AdministrativeGeography groups 6 ONS statistical and administrative area classifications as sub-classes: GovernmentOfficeRegion, UrbanRuralClassification, AdministrativeWard, ParliamentaryConstituency, LowerLayerSuperOutputArea, MiddleLayerSuperOutputArea. New object property esto:hasAdministrativeGeography links Establishment to AdministrativeGeography (0..1). Sub-properties classifiedByGovernmentOfficeRegion, classifiedByUrbanRuralClassification, classifiedByAdministrativeWard, classifiedByParliamentaryConstituency, classifiedByLowerLayerSuperOutputArea, classifiedByMiddleLayerSuperOutputArea added. New class est:Country added to MainAddress for British schools overseas and other non-England establishments; new property esto:hasCountry (domain MainAddress, range Country, 0..1). est:LocalAuthority rdfs:comment updated to make the geographic reference role explicit alongside the accountability role."@en ;
    rdfs:comment "v0.6: ontology class local names aligned with vocabulary source of truth. Renames: ContactAndLocation -> EstablishmentLocationAndContact, PostalAddress -> MainAddress, WebsiteUrl -> Website, Manager -> CentreManager, Section41ApprovalStatus -> Section41Approval. Vocabulary entries added for all 14 intermediate OWL classes and for grouping container classes (ResourcedProvisionMeasure, SenUnitMeasure, SpecialPupilMeasure, OfstedInspectionRecord, AccreditationRecord, PupilReferralUnitOperationalRecord)."@en ;
    rdfs:comment "v1.4: UI field coverage gaps addressed. New classes: InspectorateReport (inspection detail), GroupUniqueIdentifier, GroupMembershipDate, GroupStatus, GroupOpenDate, GroupIncorporatedOnDate, GroupClosedDate (establishment group lifecycle). New object properties: recordsInspectorateReport (on InspectionReportReference), sharedWith (on GovernanceAppointment, range Establishment — covers shared local governor roles), hasGroupUniqueIdentifier, hasGroupMembershipDate, hasGroupStatus, hasGroupOpenDate, hasGroupIncorporatedOnDate, hasGroupClosedDate, hasLocalAuthorityForGroup (establishment group properties; hasLocalAuthorityForGroup SHACL-scoped to children's centre group types)."@en ;
    rdfs:comment "v1.6: OfstedInspectionRecord class and hasOfstedInspectionRecord object property removed. EPR does not hold Ofsted inspection data. All SHACL property shapes referencing hasOfstedInspectionRecord removed. est:InspectorateReport rdfs:comment updated to remove the now-stale reference to OfstedInspectionRecord."@en ;
    rdfs:comment "v1.5: Site and address model separated. New classes: est:Site (physical location where education is delivered, carries site name via rdfs:label, UPRN, OS grid reference, and a postal address), est:Address (postal or correspondence address, independent of any physical site). New object properties: esto:hasMainSite (EstablishmentLocationAndContact → Site, 0..1), esto:hasAdditionalSite (EstablishmentLocationAndContact → Site, 0..*; SHACL-scoped to 3 permitted establishment types), esto:hasAddress (Site → Address, 0..1), esto:hasRegisteredAddress (no domain restriction — used on both EstablishmentLocationAndContact and EstablishmentGroup, range Address, 0..1), esto:hasContactAddress (EstablishmentGroup → Address, 0..1). Deprecated: est:MainAddress, esto:hasMainAddress. Domain updated: esto:hasUprn domain changed from MainAddress to Site; esto:hasCountry domain changed from MainAddress to Address; esto:hasOsGridReference domain extended to union of AdministrativeGeography and Site."@en ;
    rdfs:comment "v1.7: Organisation and Person superclasses added. New classes: est:Organisation (superclass of Establishment, EstablishmentGroup, LocalAuthority), est:Person (superclass of GovernancePerson). Removed classes: est:AcademySponsor, est:Proprietor, est:SchoolSponsor (SchoolSponsor was a GIAS legacy group type — sponsor is a role, not a group type). Removed property: esto:hasAcademySponsor. Added properties: esto:hasProprietor (domain Establishment, range Organisation|Person), esto:sponsoredBy (domain Establishment, range Organisation). Updated: esto:accountableToProprietor range changed from est:Proprietor to union of est:Organisation and est:Person. est:EstablishmentGroup rdfs:comment updated to remove reference to school sponsors as a group type."@en ;
    rdfs:comment "v1.8: the v1.2 governance model (8 classes, 10 object properties, 40 named individuals - GovernanceAppointment, GovernanceIdentifier, GovernanceRoleType, GovernanceAppointmentDate, GovernanceTermEndDate, GovernanceAppointingBody, GovernancePerson, GovernancePersonIdentifier and their supporting properties/individuals) removed entirely, now superseded by models/governance/governance-ontology.ttl v0.11. Reconciliation record: docs/transformation/data/modelling/claude/establishment-governance-overlap-removal-plan.md. est:GroupGovernanceAppointmentSubjectShape SHACL shape (establishment-shacl.ttl) also removed as part of this change, since it targeted the now-removed esto:hasGroupGovernanceAppointment. Nothing else in this file referenced the removed classes/properties."@en ;
    rdfs:comment "v1.9: est:TypeOfSenProvision given 12 owl:NamedIndividual values (SpeechLanguageAndCommunicationNeeds, AutisticSpectrumDisorder, SocialEmotionalAndMentalHealth, ModerateLearningDifficulty, SevereLearningDifficulty, ProfoundAndMultipleLearningDifficulty, SpecificLearningDifficulty, PhysicalDisability, HearingImpairment, VisualImpairment, MultiSensoryImpairment, OtherDifficultyOrDisability) - previously an open-ended class with no enumerated values, despite GIAS's SEN1-SEN13 fields drawing from a closed, statutory list grounded in the four broad areas of need in the SEND Code of Practice 0 to 25 (2015). Matches the real GIAS extract's 12 observed codes exactly. No 'not applicable' individual added - an establishment with no SEN provision simply has no esto:classifiedByTypeOfSenProvision triple. Also fixed: est:TypeOfResourcedProvision's rdfs:comment incorrectly described it as the SEN need type (that's est:TypeOfSenProvision's job) - it is actually which kind of specialist SEN facility exists (resourced provision unit and/or SEN unit); given 2 owl:NamedIndividual values (ResourcedProvisionFacility, and the pre-existing est:SenUnit concept reused via punning) matching its real, much smaller GIAS value set."@en ;
    rdfs:comment "v1.10: est:JobTitle added as a new owl:Class (free-text GIAS HeadPreferredJobTitle - 387 distinct values in the live extract, not a closed enumeration, so no owl:NamedIndividual values). New object property esto:hasJobTitle (domain est:HeadteacherOrPrincipal, range est:JobTitle, 0..1). Added because 'Executive Headteacher' - a real DfE-recognised title for a headteacher leading every school in a federation, per GOV.UK federations governance guidance - was previously only recorded ad hoc as an rdfs:comment on an instance, not as a modelled property."@en ;
    rdfs:comment "v1.11: esto:classifiedByTypeOfSenProvision cardinality corrected from 0..1 to 0..*. GIAS records up to 13 SEN need types per establishment (SEN1-SEN13); the real extract shows 1,619 open establishments with more than one type recorded, so the 0..1 comment was factually wrong, not just conservative. No SHACL shape previously constrained this property, so no shape change was needed - only the ontology's own cardinality documentation."@en ;
    est:status "Provisional"@en .


#################################################################
# Classes - core
#################################################################

est:Organisation
    a owl:Class ;
    rdfs:label "Organisation"@en ;
    rdfs:comment "A structured group of people working together to achieve shared goals or a specific purpose. In EPR this includes education establishments, establishment groups, local authorities, and other bodies with a role in the provision or oversight of education."@en .

est:Person
    a owl:Class ;
    rdfs:label "Person"@en ;
    rdfs:comment "A natural person with a role in the education system."@en .

est:Establishment
    a owl:Class ;
    rdfs:subClassOf est:Organisation ;
    rdfs:label "Establishment"@en ;
    rdfs:comment "The central concept. A single education provider registered with GIAS."@en .

est:EstablishmentDetails
    a owl:Class ;
    rdfs:label "Establishment details"@en ;
    rdfs:comment "The set of publicly viewable detail fields for an establishment record."@en .


#################################################################
# Classes - identity and identifiers
#################################################################

est:EstablishmentIdentity
    a owl:Class ;
    rdfs:label "Establishment identity"@en ;
    rdfs:comment "The stable identity record of an establishment, grouping its persistent identifiers."@en .

est:UniqueReferenceNumber
    a owl:Class ;
    rdfs:label "Unique Reference Number"@en ;
    rdfs:comment "The primary GIAS identifier for an establishment. Abbreviated URN."@en .

est:UkProviderReferenceNumber
    a owl:Class ;
    rdfs:label "UK Provider Reference Number"@en ;
    rdfs:comment "An external cross-sector identifier assigned by the UKPRN register. Not the primary establishment key."@en .

est:UniquePropertyReferenceNumber
    a owl:Class ;
    rdfs:label "Unique Property Reference Number"@en ;
    rdfs:comment "An Ordnance Survey identifier for the addressable property occupied by the establishment."@en .

est:EstablishmentNumber
    a owl:Class ;
    rdfs:label "Establishment number"@en ;
    rdfs:comment "A locally assigned number used within a local authority area to identify an establishment."@en .

est:DfeNumber
    a owl:Class ;
    rdfs:label "DfE number"@en ;
    rdfs:comment "A derived identifier combining local authority code and establishment number. Not independently stored."@en .

est:FeHeIdentifier
    a owl:Class ;
    rdfs:label "FE/HE identifier"@en ;
    rdfs:comment "An optional identifier for further and higher education providers, recorded in GIAS for FE colleges, sixth form centres and HEIs. Separate from UKPRN."@en .

est:LocalAuthorityScopedEstablishmentNumber
    a owl:Class ;
    rdfs:label "Local-authority-scoped establishment number"@en ;
    rdfs:comment "The establishment number together with the local authority context that makes it meaningful. Not globally unique without the LA code. Carries a role to distinguish current from previous identity."@en .

est:IdentifierRole
    a owl:Class ;
    rdfs:label "Identifier role"@en ;
    rdfs:comment "The temporal role of a local-authority-scoped establishment number, distinguishing current from previous LAESTAB-style identity."@en .


#################################################################
# Classes - lifecycle
#################################################################

est:EstablishmentLifecycle
    a owl:Class ;
    rdfs:label "Establishment lifecycle"@en ;
    rdfs:comment "The lifecycle record of an establishment, grouping its status and significant dates."@en .

est:EstablishmentStatus
    a owl:Class ;
    rdfs:label "Establishment status"@en ;
    rdfs:comment "The current lifecycle or operating-state classification of an establishment. Values include open, closed, proposed to open and open proposed to close."@en .

est:OpenDate
    a owl:Class ;
    rdfs:label "Open date"@en ;
    rdfs:comment "The date on which the establishment opened or was first registered."@en .

est:ReasonEstablishmentOpened
    a owl:Class ;
    rdfs:label "Reason establishment opened"@en ;
    rdfs:comment "The classification describing why the establishment was opened."@en .

est:ClosedDate
    a owl:Class ;
    rdfs:label "Closed date"@en ;
    rdfs:comment "The date on which the establishment closed."@en .

est:ReasonEstablishmentClosed
    a owl:Class ;
    rdfs:label "Reason establishment closed"@en ;
    rdfs:comment "The classification describing why the establishment closed."@en .


#################################################################
# Classes - record currency
#################################################################

est:RecordCurrencyAndStewardship
    a owl:Class ;
    rdfs:label "Record currency and stewardship"@en ;
    rdfs:comment "Metadata describing the currency and ownership of the GIAS establishment record itself, distinct from the lifecycle of the real-world establishment."@en .

est:DateLastChangedOrConfirmed
    a owl:Class ;
    rdfs:label "Date last changed or confirmed"@en ;
    rdfs:comment "The date on which the establishment record was last updated or confirmed as current."@en .


#################################################################
# Classes - classification
#################################################################

est:EstablishmentClassification
    a owl:Class ;
    rdfs:label "Establishment classification"@en ;
    rdfs:comment "The classification record grouping the establishment type, type group and education phase for an establishment."@en .

est:EstablishmentType
    a owl:Class ;
    rdfs:label "Establishment type"@en ;
    rdfs:comment "The legal, operational or policy classification recorded as the establishment's type. An overloaded legacy classification."@en .

est:EstablishmentTypeGroup
    a owl:Class ;
    rdfs:label "Establishment type group"@en ;
    rdfs:comment "A broad grouping of establishment types used for navigation and reporting."@en .

est:EducationPhase
    a owl:Class ;
    rdfs:label "Education phase"@en ;
    rdfs:comment "The broad stage of education provided by the establishment."@en .


#################################################################
# Classes - accountability
#################################################################

est:EstablishmentAccountability
    a owl:Class ;
    rdfs:label "Accountability relationship"@en ;
    rdfs:comment "A relationship between an establishment and the organisation accountable for it. An establishment may have zero or more accountability relationships of different kinds."@en .

est:LocalAuthority
    a owl:Class ;
    rdfs:subClassOf est:Organisation ;
    rdfs:label "Local authority"@en ;
    rdfs:comment "A local government body that serves two distinct roles for an establishment: (1) the geographic local authority in whose area the establishment is located — this scopes the establishment number within the DfE number and applies to all establishment types including academies and independent schools; (2) the body maintaining or otherwise accountable for LA-maintained schools. For academies and independent schools only the geographic reference role applies; they are not maintained by the local authority."@en .

est:AcademyTrust
    a owl:Class ;
    rdfs:subClassOf est:EstablishmentGroup ;
    rdfs:label "Academy trust"@en ;
    rdfs:comment "A charitable company limited by guarantee that enters into a funding agreement with the Secretary of State under the Academies Act 2010 to operate one or more academies or free schools. The trust is accountable for educational standards, financial management and employment of staff at its academies. An academy trust is simultaneously an accountability body (holding the funding agreement) and an establishment group (the organisational structure containing its academies)."@en .

est:SingleAcademyTrust
    a owl:Class ;
    rdfs:label "Single academy trust"@en ;
    rdfs:comment "An academy trust constituted under the Academies Act 2010 that holds a funding agreement for exactly one academy. Distinguished from a multi-academy trust, which holds funding agreements for two or more academies. A SAT can expand into a MAT by taking on a second academy."@en ;
    rdfs:subClassOf est:AcademyTrust .

#################################################################
# Classes - education, admissions and provision
#################################################################

est:EducationAdmissionsAndProvision
    a owl:Class ;
    rdfs:label "Education, admissions and provision"@en ;
    rdfs:comment "The group of classification fields describing how an establishment admits pupils and what provision it offers."@en .

est:StatutoryAgeRange
    a owl:Class ;
    rdfs:label "Statutory age range"@en ;
    rdfs:comment "The lower and upper statutory ages for which the establishment is registered."@en .

est:GenderOfEntry
    a owl:Class ;
    rdfs:label "Gender of entry"@en ;
    rdfs:comment "The gender admission classification for the establishment."@en .

est:AdmissionsPolicy
    a owl:Class ;
    rdfs:label "Admissions policy"@en ;
    rdfs:comment "The classification describing how places are allocated - selective or non-selective."@en .

est:BoardingProvision
    a owl:Class ;
    rdfs:label "Boarding provision"@en ;
    rdfs:comment "The classification describing whether boarding places are offered."@en .

est:NurseryProvision
    a owl:Class ;
    rdfs:label "Nursery provision"@en ;
    rdfs:comment "The classification describing whether the establishment offers nursery classes."@en .

est:SixthFormProvision
    a owl:Class ;
    rdfs:label "Sixth-form provision"@en ;
    rdfs:comment "The classification describing whether the establishment has a sixth form."@en .

est:SpecialClassProvision
    a owl:Class ;
    rdfs:label "Special-class provision"@en ;
    rdfs:comment "The classification describing whether the establishment has special classes."@en .


#################################################################
# Classes - capacity and pupil measures
#################################################################

est:CapacityAndPupilMeasures
    a owl:Class ;
    rdfs:label "Capacity and pupil measures"@en ;
    rdfs:comment "The group of numeric measures describing an establishment's capacity and pupil population."@en .

est:SchoolCapacity
    a owl:Class ;
    rdfs:label "School capacity"@en ;
    rdfs:comment "The total number of pupil places for which the establishment is registered. The name is a legacy field label - it applies to all establishment types."@en .

est:PupilCount
    a owl:Class ;
    rdfs:label "Pupil count"@en ;
    rdfs:comment "The number of pupils on roll at the establishment at the census date."@en .

est:PupilsEligibleForFreeSchoolMeals
    a owl:Class ;
    rdfs:label "Free school meal measure"@en ;
    rdfs:comment "The count and percentage of pupils eligible for free school meals. Includes both est:PupilsEligibleForFreeSchoolMeals and est:PercentagePupilsEligibleForFreeSchoolMeals."@en .


#################################################################
# Classes - faith context
#################################################################

est:FaithContext
    a owl:Class ;
    rdfs:label "Faith context"@en ;
    rdfs:comment "The group of faith-related classification fields for an establishment."@en .

est:ReligiousCharacter
    a owl:Class ;
    rdfs:label "Religious character"@en ;
    rdfs:comment "The formal religious-character classification designated for an establishment."@en .

est:ReligiousEthos
    a owl:Class ;
    rdfs:label "Religious ethos"@en ;
    rdfs:comment "The recorded religious-ethos classification associated with an establishment."@en .

est:Diocese
    a owl:Class ;
    rdfs:label "Diocese"@en ;
    rdfs:comment "The Church of England or Roman Catholic diocese associated with the establishment."@en .


#################################################################
# Classes - SEN and resourced provision
#################################################################

est:SenAndResourcedProvision
    a owl:Class ;
    rdfs:label "SEN and resourced provision"@en ;
    rdfs:comment "The group of fields describing special educational needs provision and resourced-provision arrangements."@en .

est:TypeOfSenProvision
    a owl:Class ;
    rdfs:label "Type of SEN provision"@en ;
    rdfs:comment "The classification describing the type of special educational needs provision offered."@en .

est:TypeOfResourcedProvision
    a owl:Class ;
    rdfs:label "Type of resourced provision"@en ;
    rdfs:comment "Which kind of specialist SEN facility the establishment hosts: a resourced provision unit, a SEN unit, or both. Not the SEN need type - see est:TypeOfSenProvision for that."@en .

est:ResourcedProvisionMeasure
    a owl:Class ;
    rdfs:label "Resourced provision measure"@en ;
    rdfs:comment "Numeric measures for resourced provision. Corresponds to est:ResourcedProvisionCapacity and est:ResourcedProvisionPupilCount in the vocabulary."@en .

est:SenUnitMeasure
    a owl:Class ;
    rdfs:label "SEN unit measure"@en ;
    rdfs:comment "Numeric measures for the SEN unit. Corresponds to est:SenUnitCapacity and est:SenUnitPupilCount in the vocabulary."@en .


#################################################################
# Classes - external references
#################################################################

est:ExternalReference
    a owl:Class ;
    rdfs:label "External reference"@en ;
    rdfs:comment "A link from the establishment record to a resource held in an external system or publication."@en .

est:InspectionReportReference
    a owl:Class ;
    rdfs:label "Inspection report reference"@en ;
    rdfs:comment "A link to an inspection report published by the relevant inspectorate."@en .

est:ExternalServiceReference
    a owl:Class ;
    rdfs:label "External service reference"@en ;
    rdfs:comment "A link to a record in an external service such as a companies register or accreditation body."@en .


#################################################################
# Object properties - core structure
#################################################################

esto:hasEstablishmentDetails
    a owl:ObjectProperty ;
    rdfs:label "has establishment details"@en ;
    rdfs:domain est:Establishment ;
    rdfs:range est:EstablishmentDetails ;
    rdfs:comment "Cardinality: exactly 1. Every establishment has exactly one set of details in this slice."@en .


#################################################################
# Object properties - identity and lifecycle
#################################################################

esto:hasEstablishmentIdentity
    a owl:ObjectProperty ;
    rdfs:label "has establishment identity"@en ;
    rdfs:domain est:Establishment ;
    rdfs:range est:EstablishmentIdentity ;
    rdfs:comment "Cardinality: exactly 1. Every establishment has exactly one identity record."@en .

esto:hasEstablishmentLifecycle
    a owl:ObjectProperty ;
    rdfs:label "has establishment lifecycle"@en ;
    rdfs:domain est:Establishment ;
    rdfs:range est:EstablishmentLifecycle ;
    rdfs:comment "Cardinality: exactly 1. Every establishment has exactly one lifecycle record."@en .

esto:hasRecordCurrency
    a owl:ObjectProperty ;
    rdfs:label "has record currency"@en ;
    rdfs:domain est:Establishment ;
    rdfs:range est:RecordCurrencyAndStewardship ;
    rdfs:comment "Cardinality: 0..1. An establishment record may have a record-currency block."@en .

esto:identifiedByUrn
    a owl:ObjectProperty ;
    rdfs:label "identified by URN"@en ;
    rdfs:domain est:EstablishmentIdentity ;
    rdfs:range est:UniqueReferenceNumber ;
    rdfs:comment "Cardinality: exactly 1. Every establishment identity is identified by exactly one URN."@en .

esto:hasUkprn
    a owl:ObjectProperty ;
    rdfs:label "has UKPRN"@en ;
    rdfs:domain est:EstablishmentIdentity ;
    rdfs:range est:UkProviderReferenceNumber ;
    rdfs:comment "Cardinality: 0..1. An establishment identity may have a UK provider reference number."@en .

esto:hasUprn
    a owl:ObjectProperty ;
    rdfs:label "has UPRN"@en ;
    rdfs:domain est:Site ;
    rdfs:range est:UniquePropertyReferenceNumber ;
    rdfs:comment "Cardinality: 0..1. UPRN identifies a physical property, not a postal address — domain updated from est:MainAddress to est:Site in v1.5. A UPRN is issued by Ordnance Survey to uniquely identify a land and property unit; it belongs on the physical site record, not on the address."@en .

esto:hasLocalAuthorityScopedEstablishmentNumber
    a owl:ObjectProperty ;
    rdfs:label "has local-authority-scoped establishment number"@en ;
    rdfs:domain est:EstablishmentIdentity ;
    rdfs:range est:LocalAuthorityScopedEstablishmentNumber ;
    rdfs:comment "Cardinality: 0..2. An identity may have a current and/or previous scoped establishment number. Replaces bare esto:hasEstablishmentNumber (v1.0) - establishment number is not globally unique without its LA context."@en .

esto:hasLocalAuthorityContext
    a owl:ObjectProperty ;
    rdfs:label "has local authority context"@en ;
    rdfs:domain est:LocalAuthorityScopedEstablishmentNumber ;
    rdfs:range est:LocalAuthority ;
    rdfs:comment "Cardinality: exactly 1. Every scoped establishment number must carry exactly one local authority context."@en .

esto:hasEstablishmentNumberValue
    a owl:ObjectProperty ;
    rdfs:label "has establishment number value"@en ;
    rdfs:domain est:LocalAuthorityScopedEstablishmentNumber ;
    rdfs:range est:EstablishmentNumber ;
    rdfs:comment "Cardinality: exactly 1. Every scoped establishment number carries the one-to-four digit establishment number value."@en .

esto:hasIdentifierRole
    a owl:ObjectProperty ;
    rdfs:label "has identifier role"@en ;
    rdfs:domain est:LocalAuthorityScopedEstablishmentNumber ;
    rdfs:range est:IdentifierRole ;
    rdfs:comment "Cardinality: exactly 1. Distinguishes current from previous LAESTAB-style identity."@en .

esto:hasFeHeIdentifier
    a owl:ObjectProperty ;
    rdfs:label "has FE/HE identifier"@en ;
    rdfs:domain est:EstablishmentIdentity ;
    rdfs:range est:FeHeIdentifier ;
    rdfs:comment "Cardinality: 0..1. Present only for further education colleges, sixth form centres and higher education institutions."@en .

esto:derivesDfeNumber
    a owl:ObjectProperty ;
    rdfs:label "derives DfE number"@en ;
    rdfs:domain est:EstablishmentIdentity ;
    rdfs:range est:DfeNumber ;
    rdfs:comment "Cardinality: 0..1. A DfE number is derived from local-authority code and establishment number, not independently stored."@en .

esto:classifiedByEstablishmentStatus
    a owl:ObjectProperty ;
    rdfs:label "classified by establishment status"@en ;
    rdfs:domain est:EstablishmentLifecycle ;
    rdfs:range est:EstablishmentStatus ;
    rdfs:comment "Cardinality: exactly 1. Every establishment lifecycle must have an establishment status."@en .

esto:hasOpenDate
    a owl:ObjectProperty ;
    rdfs:label "has open date"@en ;
    rdfs:domain est:EstablishmentLifecycle ;
    rdfs:range est:OpenDate ;
    rdfs:comment "Cardinality: 0..1."@en .

esto:hasReasonEstablishmentOpened
    a owl:ObjectProperty ;
    rdfs:label "has reason establishment opened"@en ;
    rdfs:domain est:EstablishmentLifecycle ;
    rdfs:range est:ReasonEstablishmentOpened ;
    rdfs:comment "Cardinality: 0..1."@en .

esto:hasClosedDate
    a owl:ObjectProperty ;
    rdfs:label "has closed date"@en ;
    rdfs:domain est:EstablishmentLifecycle ;
    rdfs:range est:ClosedDate ;
    rdfs:comment "Cardinality: 0..1. Only present if establishment status is closed."@en .

esto:hasReasonEstablishmentClosed
    a owl:ObjectProperty ;
    rdfs:label "has reason establishment closed"@en ;
    rdfs:domain est:EstablishmentLifecycle ;
    rdfs:range est:ReasonEstablishmentClosed ;
    rdfs:comment "Cardinality: 0..1. Only present if establishment status is closed."@en .

esto:recordsDateLastChanged
    a owl:ObjectProperty ;
    rdfs:label "records date last changed or confirmed"@en ;
    rdfs:domain est:RecordCurrencyAndStewardship ;
    rdfs:range est:DateLastChangedOrConfirmed ;
    rdfs:comment "Cardinality: 0..1."@en .


#################################################################
# Object properties - classification and accountability
#################################################################

esto:hasEstablishmentClassification
    a owl:ObjectProperty ;
    rdfs:label "has establishment classification"@en ;
    rdfs:domain est:Establishment ;
    rdfs:range est:EstablishmentClassification ;
    rdfs:comment "Cardinality: exactly 1. Every establishment has exactly one classification record."@en .

esto:hasEstablishmentType
    a owl:ObjectProperty ;
    rdfs:label "has establishment type"@en ;
    rdfs:domain est:EstablishmentClassification ;
    rdfs:range est:EstablishmentType ;
    rdfs:comment "Cardinality: exactly 1. Every classification record must have an establishment type."@en .

esto:hasEstablishmentTypeGroup
    a owl:ObjectProperty ;
    rdfs:label "has establishment type group"@en ;
    rdfs:domain est:EstablishmentClassification ;
    rdfs:range est:EstablishmentTypeGroup ;
    rdfs:comment "Cardinality: 0..1. An establishment type may belong to a type group."@en .

esto:hasEducationPhase
    a owl:ObjectProperty ;
    rdfs:label "has education phase"@en ;
    rdfs:domain est:EstablishmentClassification ;
    rdfs:range est:EducationPhase ;
    rdfs:comment "Cardinality: 0..1. Not all establishment types have an education phase."@en .

esto:hasAccountabilityRelationship
    a owl:ObjectProperty ;
    rdfs:label "has accountability relationship"@en ;
    rdfs:domain est:Establishment ;
    rdfs:range est:EstablishmentAccountability ;
    rdfs:comment "Cardinality: 0..*. An establishment may have zero or more accountability relationships depending on its type."@en .

esto:accountableToLocalAuthority
    a owl:ObjectProperty ;
    rdfs:label "accountable to local authority"@en ;
    rdfs:domain est:EstablishmentAccountability ;
    rdfs:range est:LocalAuthority ;
    rdfs:comment "Cardinality: 0..1. Present for LA-maintained schools."@en .

esto:accountableToAcademyTrust
    a owl:ObjectProperty ;
    rdfs:label "accountable to academy trust"@en ;
    rdfs:domain est:EstablishmentAccountability ;
    rdfs:range est:AcademyTrust ;
    rdfs:comment "Cardinality: 0..1. Present for academies and free schools."@en .

esto:accountableToProprietor
    a owl:ObjectProperty ;
    rdfs:label "accountable to proprietor"@en ;
    rdfs:domain est:EstablishmentAccountability ;
    rdfs:range [ a owl:Class ; owl:unionOf ( est:Organisation est:Person ) ] ;
    rdfs:comment "Cardinality: 0..1. Present for independent schools."@en .

esto:hasProprietor
    a owl:ObjectProperty ;
    rdfs:label "has proprietor"@en ;
    rdfs:domain est:Establishment ;
    rdfs:range [ a owl:Class ; owl:unionOf ( est:Organisation est:Person ) ] ;
    rdfs:comment "The person or organisation that owns or operates this independent school. Cardinality: 0..1."@en .

esto:sponsoredBy
    a owl:ObjectProperty ;
    rdfs:label "sponsored by"@en ;
    rdfs:domain est:Establishment ;
    rdfs:range est:Organisation ;
    rdfs:comment "The organisation approved by the Secretary of State to sponsor this academy or free school under the Academies Act 2010. Cardinality: 0..1."@en .

esto:isSingleAcademyTrust
    a owl:ObjectProperty ;
    rdfs:label "is single academy trust"@en ;
    rdfs:domain est:AcademyTrust ;
    rdfs:range est:SingleAcademyTrust ;
    rdfs:comment "Cardinality: 0..1. An academy trust may be a single academy trust."@en .


#################################################################
# Object properties - education, admissions and provision
#################################################################

esto:hasEducationAdmissionsAndProvision
    a owl:ObjectProperty ;
    rdfs:label "has education, admissions and provision"@en ;
    rdfs:domain est:Establishment ;
    rdfs:range est:EducationAdmissionsAndProvision ;
    rdfs:comment "Cardinality: 0..1. Not all establishment types have provision classifications."@en .

esto:hasStatutoryAgeRange
    a owl:ObjectProperty ;
    rdfs:label "has statutory age range"@en ;
    rdfs:domain est:EducationAdmissionsAndProvision ;
    rdfs:range est:StatutoryAgeRange ;
    rdfs:comment "Cardinality: 0..1."@en .

esto:classifiedByGenderOfEntry
    a owl:ObjectProperty ;
    rdfs:label "classified by gender of entry"@en ;
    rdfs:domain est:EducationAdmissionsAndProvision ;
    rdfs:range est:GenderOfEntry ;
    rdfs:comment "Cardinality: 0..1."@en .

esto:classifiedByAdmissionsPolicy
    a owl:ObjectProperty ;
    rdfs:label "classified by admissions policy"@en ;
    rdfs:domain est:EducationAdmissionsAndProvision ;
    rdfs:range est:AdmissionsPolicy ;
    rdfs:comment "Cardinality: 0..1."@en .

esto:classifiedByBoardingProvision
    a owl:ObjectProperty ;
    rdfs:label "classified by boarding provision"@en ;
    rdfs:domain est:EducationAdmissionsAndProvision ;
    rdfs:range est:BoardingProvision ;
    rdfs:comment "Cardinality: 0..1."@en .

esto:classifiedByNurseryProvision
    a owl:ObjectProperty ;
    rdfs:label "classified by nursery provision"@en ;
    rdfs:domain est:EducationAdmissionsAndProvision ;
    rdfs:range est:NurseryProvision ;
    rdfs:comment "Cardinality: 0..1."@en .

esto:classifiedBySixthFormProvision
    a owl:ObjectProperty ;
    rdfs:label "classified by sixth-form provision"@en ;
    rdfs:domain est:EducationAdmissionsAndProvision ;
    rdfs:range est:SixthFormProvision ;
    rdfs:comment "Cardinality: 0..1."@en .

esto:classifiedBySpecialClassProvision
    a owl:ObjectProperty ;
    rdfs:label "classified by special-class provision"@en ;
    rdfs:domain est:EducationAdmissionsAndProvision ;
    rdfs:range est:SpecialClassProvision ;
    rdfs:comment "Cardinality: 0..1."@en .


#################################################################
# Object properties - capacity and pupil measures
#################################################################

esto:hasCapacityAndPupilMeasures
    a owl:ObjectProperty ;
    rdfs:label "has capacity and pupil measures"@en ;
    rdfs:domain est:Establishment ;
    rdfs:range est:CapacityAndPupilMeasures ;
    rdfs:comment "Cardinality: 0..1."@en .

esto:hasSchoolCapacity
    a owl:ObjectProperty ;
    rdfs:label "has school capacity"@en ;
    rdfs:domain est:CapacityAndPupilMeasures ;
    rdfs:range est:SchoolCapacity ;
    rdfs:comment "Cardinality: 0..1."@en .

esto:hasPupilCount
    a owl:ObjectProperty ;
    rdfs:label "has pupil count"@en ;
    rdfs:domain est:CapacityAndPupilMeasures ;
    rdfs:range est:PupilCount ;
    rdfs:comment "Cardinality: 0..1."@en .

esto:hasFreeSchoolMealMeasure
    a owl:ObjectProperty ;
    rdfs:label "has free school meal measure"@en ;
    rdfs:domain est:CapacityAndPupilMeasures ;
    rdfs:range est:PupilsEligibleForFreeSchoolMeals ;
    rdfs:comment "Cardinality: 0..1. Covers both count and percentage; see est:PupilsEligibleForFreeSchoolMeals and est:PercentagePupilsEligibleForFreeSchoolMeals in the vocabulary."@en .


#################################################################
# Object properties - faith context
#################################################################

esto:hasFaithContext
    a owl:ObjectProperty ;
    rdfs:label "has faith context"@en ;
    rdfs:domain est:Establishment ;
    rdfs:range est:FaithContext ;
    rdfs:comment "Cardinality: 0..1. Not all establishment types have faith classifications."@en .

esto:classifiedByReligiousCharacter
    a owl:ObjectProperty ;
    rdfs:label "classified by religious character"@en ;
    rdfs:domain est:FaithContext ;
    rdfs:range est:ReligiousCharacter ;
    rdfs:comment "Cardinality: 0..1."@en .

esto:classifiedByReligiousEthos
    a owl:ObjectProperty ;
    rdfs:label "classified by religious ethos"@en ;
    rdfs:domain est:FaithContext ;
    rdfs:range est:ReligiousEthos ;
    rdfs:comment "Cardinality: 0..1."@en .

esto:associatedWithDiocese
    a owl:ObjectProperty ;
    rdfs:label "associated with diocese"@en ;
    rdfs:domain est:FaithContext ;
    rdfs:range est:Diocese ;
    rdfs:comment "Cardinality: 0..1. Present for Church of England and Roman Catholic establishments."@en .


#################################################################
# Object properties - SEN and resourced provision
#################################################################

esto:hasSenAndResourcedProvision
    a owl:ObjectProperty ;
    rdfs:label "has SEN and resourced provision"@en ;
    rdfs:domain est:Establishment ;
    rdfs:range est:SenAndResourcedProvision ;
    rdfs:comment "Cardinality: 0..1."@en .

esto:classifiedByTypeOfSenProvision
    a owl:ObjectProperty ;
    rdfs:label "classified by type of SEN provision"@en ;
    rdfs:domain est:SenAndResourcedProvision ;
    rdfs:range est:TypeOfSenProvision ;
    rdfs:comment "Cardinality: 0..*. GIAS records up to 13 SEN need types per establishment (SEN1-SEN13); the real extract shows 1,619 open establishments with more than one, so a single establishment can be classified by more than one type of SEN provision at once."@en .

esto:classifiedByTypeOfResourcedProvision
    a owl:ObjectProperty ;
    rdfs:label "classified by type of resourced provision"@en ;
    rdfs:domain est:SenAndResourcedProvision ;
    rdfs:range est:TypeOfResourcedProvision ;
    rdfs:comment "Cardinality: 0..1."@en .

esto:hasResourcedProvisionMeasure
    a owl:ObjectProperty ;
    rdfs:label "has resourced provision measure"@en ;
    rdfs:domain est:SenAndResourcedProvision ;
    rdfs:range est:ResourcedProvisionMeasure ;
    rdfs:comment "Cardinality: 0..1. Covers est:ResourcedProvisionCapacity and est:ResourcedProvisionPupilCount."@en .

esto:hasSenUnitMeasure
    a owl:ObjectProperty ;
    rdfs:label "has SEN unit measure"@en ;
    rdfs:domain est:SenAndResourcedProvision ;
    rdfs:range est:SenUnitMeasure ;
    rdfs:comment "Cardinality: 0..1. Covers est:SenUnitCapacity and est:SenUnitPupilCount."@en .


#################################################################
# Object properties - external references
#################################################################

esto:hasExternalReference
    a owl:ObjectProperty ;
    rdfs:label "has external reference"@en ;
    rdfs:domain est:Establishment ;
    rdfs:range est:ExternalReference ;
    rdfs:comment "Cardinality: 0..*. An establishment may have zero or more external references."@en .

esto:referencesInspectionReport
    a owl:ObjectProperty ;
    rdfs:label "references inspection report"@en ;
    rdfs:domain est:ExternalReference ;
    rdfs:range est:InspectionReportReference ;
    rdfs:comment "Cardinality: 0..1."@en .

esto:referencesExternalService
    a owl:ObjectProperty ;
    rdfs:label "references external service"@en ;
    rdfs:domain est:ExternalReference ;
    rdfs:range est:ExternalServiceReference ;
    rdfs:comment "Cardinality: 0..1."@en .


#################################################################
# Classes - contact and location
#################################################################

est:EstablishmentLocationAndContact
    a owl:Class ;
    rdfs:label "Contact and location"@en ;
    rdfs:comment "The group of fields describing how to contact and locate the establishment physically."@en .

est:MainAddress
    a owl:Class ;
    rdfs:label "Main address (superseded)"@en ;
    rdfs:comment "Superseded in v1.5 by est:Address and est:Site. Previously used as the establishment's single address concept, conflating a physical site with a postal address. Retained in the vocabulary with status Superseded. Use esto:hasRegisteredAddress → est:Address for the establishment's administrative address and esto:hasMainSite → est:Site for the principal physical site."@en .

est:Website
    a owl:Class ;
    rdfs:label "Website"@en ;
    rdfs:comment "The establishment's public website URL."@en .

est:TelephoneNumber
    a owl:Class ;
    rdfs:label "Telephone number"@en ;
    rdfs:comment "The establishment's main contact telephone number."@en .

est:HeadteacherOrPrincipal
    a owl:Class ;
    rdfs:label "Headteacher or principal"@en ;
    rdfs:comment "The named person leading the establishment. The GIAS UI label varies by type: Headteacher / Principal for most schools; Manager for children's centres; Headteacher/Manager for online providers. Treated as a single concept in the EPR model."@en .

est:JobTitle
    a owl:Class ;
    rdfs:label "Job title"@en ;
    rdfs:comment "The free-text job title GIAS records for a headteacher or principal (HeadPreferredJobTitle) - e.g. 'Headteacher', 'Executive Headteacher', 'Principal', 'Head of School'. Not a closed enumeration: the live extract shows 387 distinct values, many of them formatting variants of the same underlying title. 'Executive Headteacher' is a real, DfE-recognised title for a headteacher with responsibility for every school in a federation (see the GOV.UK federations governance guidance), but the GIAS field is free text entered per establishment, not validated against that specific meaning - a person's title here should not be assumed to imply cross-establishment leadership without separate confirmation."@en .

est:Country
    a owl:Class ;
    rdfs:label "Country"@en ;
    rdfs:comment "The country of an address. Relevant for British schools overseas and other establishments located outside England. Distinct from the County text field in the address. In GIAS this is stored as Establishment.Country_code referencing the Nationality table — a legacy naming mismatch; the target model uses this class to clarify the concept as country of location rather than nationality."@en .


#################################################################
# Classes - site and address (v1.5)
#
# Sites and addresses are independent concepts. A site is a
# physical location where education is delivered. An address is a
# postal or correspondence locator. A site has an address; an
# establishment may also carry a registered address independently
# of any site (e.g. an administrative postal address that differs
# from the teaching location).
#################################################################

est:Site
    a owl:Class ;
    rdfs:label "Site"@en ;
    rdfs:comment "A physical location at which an establishment operates. The site name is carried as rdfs:label. A site carries a UPRN (identifying the physical property), OS grid coordinates, and a postal address (via esto:hasAddress). Distinct from est:Address — a site is where education is delivered; an address locates an entity for administrative and correspondence purposes. Added v1.5."@en .

est:Address
    a owl:Class ;
    rdfs:label "Address"@en ;
    rdfs:comment "A postal or correspondence address. An independent concept from est:Site — an address locates an establishment, site, or group for administrative and correspondence purposes. An establishment may have a registered address that differs from its principal teaching site. A trust or group has a registered address (and optionally a contact address) as a legal entity. Added v1.5."@en .


#################################################################
# Classes - administrative geography (v1.3)
#
# Administrative and statistical area classifications derived from
# an establishment's postcode location, principally via the GeoData
# lookup table. Grouped under est:AdministrativeGeography as a peer
# of est:EstablishmentLocationAndContact on est:Establishment.
#################################################################

est:AdministrativeGeography
    a owl:Class ;
    rdfs:label "Administrative geography"@en ;
    rdfs:comment "The administrative and statistical area classifications assigned to an establishment based on its postcode location. These are derived from the postcode via the GeoData lookup table or an equivalent postcode-to-area service. Covers ONS government office region, urban/rural classification, administrative ward, parliamentary constituency, lower-layer super output area and middle-layer super output area."@en .

est:GovernmentOfficeRegion
    a owl:Class ;
    rdfs:subClassOf est:AdministrativeGeography ;
    rdfs:label "Government Office Region"@en ;
    rdfs:comment "The ONS Government Office Region for the establishment's postcode. England has 9 GORs. In GIAS: Establishment.GOR_code → GovernmentOfficeRegion."@en .

est:UrbanRuralClassification
    a owl:Class ;
    rdfs:subClassOf est:AdministrativeGeography ;
    rdfs:label "Urban/rural classification"@en ;
    rdfs:comment "The ONS urban/rural classification for the establishment's postcode. Values include urban city and town, rural village, rural hamlet and isolated dwelling. In GIAS: Establishment.UrbanRural_code → UrbanRural."@en .

est:AdministrativeWard
    a owl:Class ;
    rdfs:subClassOf est:AdministrativeGeography ;
    rdfs:label "Administrative ward"@en ;
    rdfs:comment "The administrative ward for the establishment's postcode, derived via GeoData. In GIAS: Establishment.administrativeWard_code → AdministrativeWard."@en .

est:ParliamentaryConstituency
    a owl:Class ;
    rdfs:subClassOf est:AdministrativeGeography ;
    rdfs:label "Parliamentary constituency"@en ;
    rdfs:comment "The parliamentary constituency for the establishment's postcode, derived via GeoData. In GIAS: Establishment.parliamentaryConstituency_code → ParliamentaryConstituency."@en .

est:LowerLayerSuperOutputArea
    a owl:Class ;
    rdfs:subClassOf est:AdministrativeGeography ;
    rdfs:label "Lower-layer Super Output Area"@en ;
    rdfs:comment "The LSOA for the establishment's postcode. Small-area statistical geography; the key link to deprivation data such as IDACI. In GIAS: Establishment.lsoa_code → LSOA."@en .

est:MiddleLayerSuperOutputArea
    a owl:Class ;
    rdfs:subClassOf est:AdministrativeGeography ;
    rdfs:label "Middle-layer Super Output Area"@en ;
    rdfs:comment "The MSOA for the establishment's postcode. Mid-level statistical geography. In GIAS: Establishment.msoa_code → MSOA."@en .

est:DistrictAdministrative
    a owl:Class ;
    rdfs:subClassOf est:AdministrativeGeography ;
    rdfs:label "Administrative district"@en ;
    rdfs:comment "The administrative district for the establishment's postcode. Displayed on the establishment location tab in GIAS. In two-tier areas this is a district council below county level; in unitary authority, metropolitan and London borough areas the district and local authority are the same body. In GIAS: Establishment.districtAdministrative_code → DistrictAdministrative."@en .

est:GssLocalAuthorityCode
    a owl:Class ;
    rdfs:subClassOf est:AdministrativeGeography ;
    rdfs:label "GSS local authority code"@en ;
    rdfs:comment "The ONS Government Statistical Service code for the local authority in whose area the establishment is located (for example E08000007). A standard machine-readable identifier used for cross-referencing with ONS statistical datasets. Displayed on the establishment location tab in GIAS. In GIAS: Establishment.GssLaCode_code → GSSLACode."@en .

est:OsGridReference
    a owl:Class ;
    rdfs:subClassOf est:AdministrativeGeography ;
    rdfs:label "OS grid reference"@en ;
    rdfs:comment "The Ordnance Survey National Grid reference for the establishment's location, comprising easting and northing values in the OSGB36 coordinate reference system. Derived from the establishment's postcode. Both easting and northing are displayed on the establishment location tab in GIAS."@en .

est:Easting
    a owl:Class ;
    rdfs:label "Easting"@en ;
    rdfs:comment "The easting component of the OS National Grid reference, in metres east of the grid origin."@en .

est:Northing
    a owl:Class ;
    rdfs:label "Northing"@en ;
    rdfs:comment "The northing component of the OS National Grid reference, in metres north of the grid origin."@en .


#################################################################
# Classes - further education sub-classification and Section 41
#################################################################

est:FurtherEducationType
    a owl:Class ;
    rdfs:label "Further education type"@en ;
    rdfs:comment "A sub-classification of further education and pupil referral unit establishments. Observed for FE colleges (type 18), higher education institutions (type 29) and pupil referral units (type 14)."@en .

est:Section41Approval
    a owl:Class ;
    rdfs:label "Section 41 approval status"@en ;
    rdfs:comment "Whether the establishment is approved under Section 41 of the Children and Families Act 2014 to accept placements of pupils with education, health and care plans."@en .


#################################################################
# Classes - inspection detail (non-Ofsted inspectorates and BSO)
#################################################################

est:InspectorateName
    a owl:Class ;
    rdfs:label "Inspectorate name"@en ;
    rdfs:comment "The name of the inspectorate body responsible for inspecting the establishment. Used for independent schools and British schools overseas where the inspectorate is not Ofsted."@en .

est:DateOfLastInspectionVisit
    a owl:Class ;
    rdfs:label "Date of last inspection visit"@en ;
    rdfs:comment "The date of the most recent inspection visit by the named inspectorate. Observed for British schools overseas (type 37) and independent schools."@en .

est:DateOfNextInspectionVisit
    a owl:Class ;
    rdfs:label "Date of next inspection visit"@en ;
    rdfs:comment "The scheduled date of the next inspection visit. Observed for British schools overseas (type 37)."@en .

est:InspectorateReport
    a owl:Class ;
    rdfs:label "Inspectorate report"@en ;
    rdfs:comment "A URL reference to the most recent inspection report published by the named non-Ofsted inspectorate. Used for British schools overseas inspected under the British Schools Overseas framework."@en .


#################################################################
# Classes - special pupils SEN measures
#################################################################

est:SpecialPupilMeasure
    a owl:Class ;
    rdfs:label "Special pupil measure"@en ;
    rdfs:comment "Numeric measures for pupils with special educational needs. Covers the count of pupils with a SEN statement or education, health and care plan and the count of pupils with SEN needs but without such a plan."@en .


#################################################################
# Object properties - contact and location
#################################################################

esto:hasEstablishmentLocationAndContact
    a owl:ObjectProperty ;
    rdfs:label "has contact and location"@en ;
    rdfs:domain est:Establishment ;
    rdfs:range est:EstablishmentLocationAndContact ;
    rdfs:comment "Cardinality: 0..1."@en .

esto:hasMainAddress
    a owl:ObjectProperty ;
    rdfs:label "has main address (superseded)"@en ;
    rdfs:domain est:EstablishmentLocationAndContact ;
    rdfs:range est:MainAddress ;
    rdfs:comment "Superseded in v1.5. Use esto:hasRegisteredAddress → est:Address for the establishment's postal address and esto:hasMainSite → est:Site for the principal physical site."@en .

esto:hasMainSite
    a owl:ObjectProperty ;
    rdfs:label "has main site"@en ;
    rdfs:domain est:EstablishmentLocationAndContact ;
    rdfs:range est:Site ;
    rdfs:comment "Cardinality: 0..1. The principal physical site of an establishment — the location where education is primarily delivered. The site name is rdfs:label on the est:Site instance. Mapped from GIAS Establishment.siteName, Street, Locality, Address3, Town, Postcode, UPRN. Added v1.5."@en .

esto:hasAdditionalSite
    a owl:ObjectProperty ;
    rdfs:label "has additional site"@en ;
    rdfs:domain est:EstablishmentLocationAndContact ;
    rdfs:range est:Site ;
    rdfs:comment "Cardinality: 0..*. An additional physical site at which the establishment operates. Mapped from GIAS EstablishmentAdditionalAddresses (record_number, siteName, street, locality, address3, town, postcode, uprn, easting, northing). Application-level constraint (SHACL): permitted only for Other independent school (type 11), Other independent special school (type 10), and Non-maintained special school (type 08). Added v1.5."@en .

esto:hasAddress
    a owl:ObjectProperty ;
    rdfs:label "has address"@en ;
    rdfs:domain est:Site ;
    rdfs:range est:Address ;
    rdfs:comment "Cardinality: 0..1. The postal address of a site. Separates the physical location concept (est:Site) from its postal address (est:Address). Added v1.5."@en .

esto:hasRegisteredAddress
    a owl:ObjectProperty ;
    rdfs:label "has registered address"@en ;
    rdfs:domain est:EstablishmentGroup ;
    rdfs:range est:Address ;
    rdfs:comment "Cardinality: 0..1. The registered postal address of a group or trust as a legal entity. Mapped from GIAS EstablishmentGroup.GroupStreet, GroupLocality, GroupAddress3, GroupTown, GroupPostcode. Establishments do not carry a registered address directly — their postal address is accessed via esto:hasMainSite → esto:hasAddress. Added v1.5."@en .

esto:hasContactAddress
    a owl:ObjectProperty ;
    rdfs:label "has contact address"@en ;
    rdfs:domain est:EstablishmentGroup ;
    rdfs:range est:Address ;
    rdfs:comment "Cardinality: 0..1. The contact or correspondence address of a group or trust, where this differs from the registered address. Mapped from GIAS EstablishmentGroup.GroupContactStreet, GroupContactLocality, GroupContactAddress3, GroupContactTown, GroupContactPostcode, GroupContactUPRN. Added v1.5."@en .

esto:hasWebsite
    a owl:ObjectProperty ;
    rdfs:label "has website URL"@en ;
    rdfs:domain est:EstablishmentLocationAndContact ;
    rdfs:range est:Website ;
    rdfs:comment "Cardinality: 0..1."@en .

esto:hasJobTitle
    a owl:ObjectProperty ;
    rdfs:label "has job title"@en ;
    rdfs:domain est:HeadteacherOrPrincipal ;
    rdfs:range est:JobTitle ;
    rdfs:comment "Cardinality: 0..1. Free-text GIAS job title (HeadPreferredJobTitle), e.g. 'Headteacher', 'Executive Headteacher', 'Principal'."@en .

esto:hasTelephoneNumber
    a owl:ObjectProperty ;
    rdfs:label "has telephone number"@en ;
    rdfs:domain est:EstablishmentLocationAndContact ;
    rdfs:range est:TelephoneNumber ;
    rdfs:comment "Cardinality: 0..1."@en .

esto:hasHeadteacherOrPrincipal
    a owl:ObjectProperty ;
    rdfs:label "has headteacher or principal"@en ;
    rdfs:domain est:EstablishmentLocationAndContact ;
    rdfs:range est:HeadteacherOrPrincipal ;
    rdfs:comment "Cardinality: 0..1."@en .

esto:hasCountry
    a owl:ObjectProperty ;
    rdfs:label "has country"@en ;
    rdfs:domain est:Address ;
    rdfs:range est:Country ;
    rdfs:comment "Cardinality: 0..1. Present for British schools overseas and establishments located outside England. Domain updated from est:MainAddress to est:Address in v1.5."@en .


#################################################################
# Object properties - administrative geography (v1.3)
#################################################################

esto:hasAdministrativeGeography
    a owl:ObjectProperty ;
    rdfs:label "has administrative geography"@en ;
    rdfs:domain est:Establishment ;
    rdfs:range est:AdministrativeGeography ;
    rdfs:comment "Cardinality: 0..1. Links an establishment to its administrative and statistical area classifications, derived from its postcode location."@en .

esto:classifiedByGovernmentOfficeRegion
    a owl:ObjectProperty ;
    rdfs:label "classified by Government Office Region"@en ;
    rdfs:domain est:AdministrativeGeography ;
    rdfs:range est:GovernmentOfficeRegion ;
    rdfs:comment "Cardinality: 0..1."@en .

esto:classifiedByUrbanRuralClassification
    a owl:ObjectProperty ;
    rdfs:label "classified by urban/rural classification"@en ;
    rdfs:domain est:AdministrativeGeography ;
    rdfs:range est:UrbanRuralClassification ;
    rdfs:comment "Cardinality: 0..1."@en .

esto:classifiedByAdministrativeWard
    a owl:ObjectProperty ;
    rdfs:label "classified by administrative ward"@en ;
    rdfs:domain est:AdministrativeGeography ;
    rdfs:range est:AdministrativeWard ;
    rdfs:comment "Cardinality: 0..1."@en .

esto:classifiedByParliamentaryConstituency
    a owl:ObjectProperty ;
    rdfs:label "classified by parliamentary constituency"@en ;
    rdfs:domain est:AdministrativeGeography ;
    rdfs:range est:ParliamentaryConstituency ;
    rdfs:comment "Cardinality: 0..1."@en .

esto:classifiedByLowerLayerSuperOutputArea
    a owl:ObjectProperty ;
    rdfs:label "classified by Lower-layer Super Output Area"@en ;
    rdfs:domain est:AdministrativeGeography ;
    rdfs:range est:LowerLayerSuperOutputArea ;
    rdfs:comment "Cardinality: 0..1."@en .

esto:classifiedByMiddleLayerSuperOutputArea
    a owl:ObjectProperty ;
    rdfs:label "classified by Middle-layer Super Output Area"@en ;
    rdfs:domain est:AdministrativeGeography ;
    rdfs:range est:MiddleLayerSuperOutputArea ;
    rdfs:comment "Cardinality: 0..1."@en .

esto:classifiedByDistrictAdministrative
    a owl:ObjectProperty ;
    rdfs:label "classified by administrative district"@en ;
    rdfs:domain est:AdministrativeGeography ;
    rdfs:range est:DistrictAdministrative ;
    rdfs:comment "Cardinality: 0..1."@en .

esto:hasGssLocalAuthorityCode
    a owl:ObjectProperty ;
    rdfs:label "has GSS local authority code"@en ;
    rdfs:domain est:AdministrativeGeography ;
    rdfs:range est:GssLocalAuthorityCode ;
    rdfs:comment "Cardinality: 0..1. The ONS GSS code for the geographic local authority."@en .

esto:hasOsGridReference
    a owl:ObjectProperty ;
    rdfs:label "has OS grid reference"@en ;
    rdfs:range est:OsGridReference ;
    rdfs:comment "Cardinality: 0..1. Easting and northing in OSGB36. Used on est:AdministrativeGeography (derived from the establishment's postcode) and on est:Site (stored directly from GIAS EstablishmentAdditionalAddresses). No domain restriction — attachment is constrained by SHACL."@en .

esto:hasEasting
    a owl:ObjectProperty ;
    rdfs:label "has easting"@en ;
    rdfs:domain est:OsGridReference ;
    rdfs:range est:Easting ;
    rdfs:comment "Cardinality: exactly 1."@en .

esto:hasNorthing
    a owl:ObjectProperty ;
    rdfs:label "has northing"@en ;
    rdfs:domain est:OsGridReference ;
    rdfs:range est:Northing ;
    rdfs:comment "Cardinality: exactly 1."@en .


#################################################################
# Object properties - further education sub-classification and Section 41
#################################################################

esto:classifiedByFurtherEducationType
    a owl:ObjectProperty ;
    rdfs:label "classified by further education type"@en ;
    rdfs:domain est:EstablishmentClassification ;
    rdfs:range est:FurtherEducationType ;
    rdfs:comment "Cardinality: 0..1. Present for further education (type 18), higher education institutions (type 29) and pupil referral units (type 14)."@en .

esto:classifiedBySection41Approval
    a owl:ObjectProperty ;
    rdfs:label "classified by Section 41 approval status"@en ;
    rdfs:domain est:EstablishmentClassification ;
    rdfs:range est:Section41Approval ;
    rdfs:comment "Cardinality: 0..1. Present for non-maintained special schools, independent special schools, and many academy and free school types."@en .


