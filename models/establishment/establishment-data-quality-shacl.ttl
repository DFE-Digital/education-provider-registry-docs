@prefix est:     <https://dfe-digital.github.io/education-provider-registry-docs/models/establishment/vocabulary/> .
@prefix esto:    <https://dfe-digital.github.io/education-provider-registry-docs/models/establishment/ontology/> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# Education Provider Registry - Data Quality SHACL Shapes
#
# Scope: value-level constraints on EPR establishment fields.
# This file constrains datatypes, ranges and cardinality for properties
# already defined in establishment-ontology.ttl.
#
# It is separate from establishment-shacl.ttl, which constrains
# structural shape (which fields are required, optional or not applicable
# per establishment type). Both files can be validated together or
# independently.
#
# Convention: scalar values are attached to class instances via rdf:value.
# For example, a UniqueReferenceNumber instance carries its integer value
# as rdf:value. Compound measures (e.g. FSM count + percentage) use
# named vocabulary properties - see deferred items at the end of this file.
#
# Sits alongside:
#   establishment-ontology.ttl  (OWL ontology - v0.3)
#   establishment-shacl.ttl             (structural SHACL - v0.2)
#   establishment-taxonomy.ttl     (SKOS taxonomy)
#   establishment-vocabulary.ttl   (SKOS vocabulary)


#################################################################
# Shapes graph declaration
#################################################################

<https://dfe-digital.github.io/education-provider-registry-docs/shapes/data-quality/>
    a owl:Ontology ;
    dcterms:title "Education Provider Registry Data Quality SHACL Shapes"@en ;
    dcterms:description "Value-level SHACL constraints for EPR establishment records: datatypes, numeric ranges and cardinality rules for identity, lifecycle and measure fields."@en ;
    dcterms:created "2026-06-19"^^xsd:date ;
    dcterms:modified "2026-11-27"^^xsd:date ;
    dcterms:publisher "Department for Education"@en ;
    dcterms:license <https://www.nationalarchives.gov.uk/doc/open-government-licence/version/3/> ;
    owl:versionInfo "0.3" ;
    rdfs:comment "v0.3: aligned with establishment-ontology.ttl v2.4. Warnings added for establishment reorganisations: a predecessor whose lifecycle is not closed, a pattern that does not match the reorganisation's successions, provision transfers and outcomes, a participant that neither gives nor receives provision, and a successor shortcut with no matching succession."@en ;
    rdfs:comment "v0.2: aligned with establishment-ontology.ttl v2.3. Two warnings added: a traditional partnership with fewer than two recorded partners, and a maintaining local authority that is not the current local authority for the establishment's area. The second is a SHACL-SPARQL constraint, because SHACL Core cannot compare two paths."@en ;
    rdfs:seeAlso <https://dfe-digital.github.io/education-provider-registry-docs/models/establishment/ontology/> ;
    rdfs:seeAlso <https://dfe-digital.github.io/education-provider-registry-docs/shapes/> ;
    est:status "Provisional"@en .


#################################################################
# Identity - URN
#################################################################

est:UrnValueShape
    a sh:NodeShape ;
    sh:targetClass est:UniqueReferenceNumber ;
    rdfs:label "URN value shape"@en ;
    rdfs:comment "A URN must carry exactly one value, which must be a positive integer in the 6-digit GIAS range."@en ;

    sh:property [
        sh:path rdf:value ;
        sh:datatype xsd:positiveInteger ;
        sh:minInclusive 100000 ;
        sh:maxInclusive 999999 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:name "URN value"@en ;
        sh:message "URN must be a 6-digit positive integer between 100000 and 999999."@en ;
    ] .


#################################################################
# Identity - UKPRN
#################################################################

est:UkprnValueShape
    a sh:NodeShape ;
    sh:targetClass est:UkProviderReferenceNumber ;
    rdfs:label "UKPRN value shape"@en ;
    rdfs:comment "A UKPRN must carry exactly one value, which must be an 8-digit positive integer."@en ;

    sh:property [
        sh:path rdf:value ;
        sh:datatype xsd:positiveInteger ;
        sh:minInclusive 10000000 ;
        sh:maxInclusive 99999999 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:name "UKPRN value"@en ;
        sh:message "UKPRN must be an 8-digit positive integer between 10000000 and 99999999."@en ;
    ] .


#################################################################
# Identity - establishment number
#################################################################

est:EstablishmentNumberValueShape
    a sh:NodeShape ;
    sh:targetClass est:EstablishmentNumber ;
    rdfs:label "Establishment number value shape"@en ;
    rdfs:comment "An establishment number must carry exactly one value, a positive integer between 1 and 9999. The four-digit zero-padded display form belongs to DfE number / LAESTAB rendering, not the stored value."@en ;

    sh:property [
        sh:path rdf:value ;
        sh:datatype xsd:positiveInteger ;
        sh:minInclusive 1 ;
        sh:maxInclusive 9999 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:name "Establishment number value"@en ;
        sh:message "Establishment number must be a positive integer between 1 and 9999."@en ;
    ] .


#################################################################
# Lifecycle - dates
#################################################################

est:OpenDateValueShape
    a sh:NodeShape ;
    sh:targetClass est:OpenDate ;
    rdfs:label "Open date value shape"@en ;

    sh:property [
        sh:path rdf:value ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:name "Open date value"@en ;
        sh:message "Open date must be an xsd:date value."@en ;
    ] .

est:ClosedDateValueShape
    a sh:NodeShape ;
    sh:targetClass est:ClosedDate ;
    rdfs:label "Closed date value shape"@en ;

    sh:property [
        sh:path rdf:value ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:name "Closed date value"@en ;
        sh:message "Closed date must be an xsd:date value."@en ;
    ] .

est:DateLastChangedValueShape
    a sh:NodeShape ;
    sh:targetClass est:DateLastChangedOrConfirmed ;
    rdfs:label "Date last changed value shape"@en ;

    sh:property [
        sh:path rdf:value ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:name "Date last changed value"@en ;
        sh:message "Date last changed or confirmed must be an xsd:date value."@en ;
    ] .


#################################################################
# Lifecycle - inspection dates (BSO and independent schools)
#################################################################

est:DateOfLastInspectionVisitValueShape
    a sh:NodeShape ;
    sh:targetClass est:DateOfLastInspectionVisit ;
    rdfs:label "Date of last inspection visit value shape"@en ;

    sh:property [
        sh:path rdf:value ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:name "Date of last inspection visit value"@en ;
        sh:message "Date of last inspection visit must be an xsd:date value."@en ;
    ] .

est:DateOfNextInspectionVisitValueShape
    a sh:NodeShape ;
    sh:targetClass est:DateOfNextInspectionVisit ;
    rdfs:label "Date of next inspection visit value shape"@en ;

    sh:property [
        sh:path rdf:value ;
        sh:datatype xsd:date ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:name "Date of next inspection visit value"@en ;
        sh:message "Date of next inspection visit must be an xsd:date value."@en ;
    ] .


#################################################################
# Capacity and pupil measures
#################################################################

est:SchoolCapacityValueShape
    a sh:NodeShape ;
    sh:targetClass est:SchoolCapacity ;
    rdfs:label "School capacity value shape"@en ;

    sh:property [
        sh:path rdf:value ;
        sh:datatype xsd:nonNegativeInteger ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:name "School capacity value"@en ;
        sh:message "School capacity must be a non-negative integer."@en ;
    ] .

est:PupilCountValueShape
    a sh:NodeShape ;
    sh:targetClass est:PupilCount ;
    rdfs:label "Pupil count value shape"@en ;

    sh:property [
        sh:path rdf:value ;
        sh:datatype xsd:nonNegativeInteger ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:name "Pupil count value"@en ;
        sh:message "Pupil count must be a non-negative integer."@en ;
    ] .


#################################################################
# SEN and resourced provision measures
#################################################################

est:ResourcedProvisionMeasureShape
    a sh:NodeShape ;
    sh:targetClass est:ResourcedProvisionMeasure ;
    rdfs:label "Resourced provision measure shape"@en ;
    rdfs:comment "Both capacity and number on roll for a resourced provision unit must be non-negative integers. Number on roll must not exceed capacity."@en ;

    sh:property [
        sh:path est:ResourcedProvisionCapacity ;
        sh:datatype xsd:nonNegativeInteger ;
        sh:maxCount 1 ;
        sh:name "Resourced provision capacity"@en ;
        sh:message "Resourced provision capacity must be a non-negative integer."@en ;
    ] ;

    sh:property [
        sh:path est:ResourcedProvisionPupilCount ;
        sh:datatype xsd:nonNegativeInteger ;
        sh:maxCount 1 ;
        sh:name "Resourced provision number on roll"@en ;
        sh:message "Resourced provision number on roll must be a non-negative integer."@en ;
    ] .

est:SenUnitMeasureShape
    a sh:NodeShape ;
    sh:targetClass est:SenUnitMeasure ;
    rdfs:label "SEN unit measure shape"@en ;
    rdfs:comment "Both capacity and number on roll for a SEN unit must be non-negative integers."@en ;

    sh:property [
        sh:path est:SenUnitCapacity ;
        sh:datatype xsd:nonNegativeInteger ;
        sh:maxCount 1 ;
        sh:name "SEN unit capacity"@en ;
        sh:message "SEN unit capacity must be a non-negative integer."@en ;
    ] ;

    sh:property [
        sh:path est:SenUnitPupilCount ;
        sh:datatype xsd:nonNegativeInteger ;
        sh:maxCount 1 ;
        sh:name "SEN unit number on roll"@en ;
        sh:message "SEN unit number on roll must be a non-negative integer."@en ;
    ] .

est:SpecialPupilMeasureShape
    a sh:NodeShape ;
    sh:targetClass est:SpecialPupilMeasure ;
    rdfs:label "Special pupil measure shape"@en ;
    rdfs:comment "Counts of pupils with and without SEN statements or EHC plans must be non-negative integers."@en ;

    sh:property [
        sh:path est:SpecialPupilsWithStatement ;
        sh:datatype xsd:nonNegativeInteger ;
        sh:maxCount 1 ;
        sh:name "Special pupils with SEN statement or EHC plan"@en ;
        sh:message "Count of special pupils under a SEN statement or EHC plan must be a non-negative integer."@en ;
    ] ;

    sh:property [
        sh:path est:SpecialPupilsWithoutStatement ;
        sh:datatype xsd:nonNegativeInteger ;
        sh:maxCount 1 ;
        sh:name "Special pupils without SEN statement or EHC plan"@en ;
        sh:message "Count of special pupils not under a SEN statement or EHC plan must be a non-negative integer."@en ;
    ] .


#################################################################
# Statutory age range
#################################################################

est:StatutoryAgeRangeShape
    a sh:NodeShape ;
    sh:targetClass est:StatutoryAgeRange ;
    rdfs:label "Statutory age range shape"@en ;
    rdfs:comment "Lower and upper statutory ages must be non-negative integers within valid bounds, and the upper age must not be less than the lower age."@en ;

    sh:property [
        sh:path est:AgeLow ;
        sh:datatype xsd:nonNegativeInteger ;
        sh:minInclusive 0 ;
        sh:maxInclusive 19 ;
        sh:maxCount 1 ;
        sh:name "Lower statutory age"@en ;
        sh:message "Lower statutory age must be a non-negative integer not greater than 19."@en ;
    ] ;

    sh:property [
        sh:path est:AgeHigh ;
        sh:datatype xsd:nonNegativeInteger ;
        sh:minInclusive 0 ;
        sh:maxInclusive 25 ;
        sh:maxCount 1 ;
        sh:name "Upper statutory age"@en ;
        sh:message "Upper statutory age must be a non-negative integer not greater than 25."@en ;
    ] .


#################################################################
# Deferred - pending vocabulary data property definitions
#
# The following fields require data properties to be defined in
# establishment-vocabulary.ttl before SHACL constraints
# can be expressed for their values:
#
# - PupilsEligibleForFreeSchoolMeals (count):
#     Requires est:PupilsEligibleForFreeSchoolMeals data property.
#     Constraint: xsd:nonNegativeInteger.
#
# - PupilsEligibleForFreeSchoolMeals (percentage):
#     Requires est:PercentagePupilsEligibleForFreeSchoolMeals data property.
#     Constraint: xsd:decimal; sh:minInclusive 0; sh:maxInclusive 100.
#
# These are documented here as pending items, not structural omissions.
#################################################################




#################################################################
# Legal entities and local authorities (v0.2)
#################################################################

est:PartnerCountShape
    a sh:NodeShape ;
    rdfs:label "Partner count shape"@en ;
    rdfs:comment "Warning, not violation: a traditional partnership has at least two partners, but GIAS records only a name such as 'Mr & Mrs Readhead (Partnership)', so partners are usually not known. We do not create person records to fill the gap. Added v0.2."@en ;
    sh:targetClass est:LegalEntity ;
    sh:severity sh:Warning ;
    sh:or (
        [ sh:not [ sh:path esto:hasLegalForm ; sh:hasValue est:TraditionalPartnership ] ]
        [ sh:path esto:hasPartnershipMembership ;
          sh:qualifiedValueShape [ sh:not [ sh:path esto:hasEndDate ; sh:minCount 1 ] ] ;
          sh:qualifiedMinCount 2 ]
    ) ;
    sh:message "A traditional partnership should record at least two current partners."@en .

est:MaintainingAuthorityMatchesAreaShape
    a sh:NodeShape ;
    rdfs:label "Maintaining authority matches area shape"@en ;
    rdfs:comment "Warning, not violation: a maintained school's maintaining local authority should be the current local authority for the area the school is in. Migration derives one from the other, so a mismatch can only come from a later edit. Added v0.2."@en ;
    sh:targetSubjectsOf esto:maintainedByLocalAuthority ;
    sh:severity sh:Warning ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The maintaining local authority {?la} is not the current local authority for the establishment's area {?area}."@en ;
        sh:select """
            SELECT $this ?la ?area WHERE {
                $this <https://dfe-digital.github.io/education-provider-registry-docs/models/establishment/ontology/maintainedByLocalAuthority> ?la .
                $this <https://dfe-digital.github.io/education-provider-registry-docs/models/establishment/ontology/hasAdministrativeGeography>/<https://dfe-digital.github.io/education-provider-registry-docs/models/establishment/ontology/classifiedByLocalAuthorityArea> ?area .
                FILTER NOT EXISTS {
                    ?area <https://dfe-digital.github.io/education-provider-registry-docs/models/establishment/ontology/hasLocalAuthorityAreaPeriod> ?period .
                    ?period <https://dfe-digital.github.io/education-provider-registry-docs/models/establishment/ontology/hasLocalAuthority> ?la .
                    FILTER NOT EXISTS { ?period <https://dfe-digital.github.io/education-provider-registry-docs/models/establishment/ontology/hasEndDate> ?end }
                }
            }
        """ ;
    ] .


#################################################################
# Establishment reorganisation (v0.3)
#
# Warnings, not violations. A mismatch means either the recorded
# pattern or the recorded participants are wrong, and needs review.
# The SPARQL uses the prefixes declared on this shapes graph below.
#################################################################

<https://dfe-digital.github.io/education-provider-registry-docs/shapes/data-quality/>
    sh:declare
        [ sh:prefix "esto" ; sh:namespace "https://dfe-digital.github.io/education-provider-registry-docs/models/establishment/ontology/"^^xsd:anyURI ] ,
        [ sh:prefix "est" ; sh:namespace "https://dfe-digital.github.io/education-provider-registry-docs/models/establishment/vocabulary/"^^xsd:anyURI ] .

est:PredecessorLifecycleClosedShape
    a sh:NodeShape ;
    rdfs:label "Predecessor lifecycle closed shape"@en ;
    rdfs:comment "Warning, not violation: the predecessor in a succession should have the lifecycle status closed. Its outcome in the reorganisation is closed, so the two should agree. Added v0.3."@en ;
    sh:targetClass est:Succession ;
    sh:severity sh:Warning ;
    sh:property [
        sh:path ( esto:hasPredecessorEstablishment esto:hasEstablishmentLifecycle esto:classifiedByEstablishmentStatus ) ;
        sh:severity sh:Warning ;
        sh:hasValue est:ClosedStatus ;
        sh:name "Predecessor status"@en ;
        sh:message "The predecessor's lifecycle status should be closed."@en ;
    ] .

est:ReorganisationPatternMatchShape
    a sh:NodeShape ;
    rdfs:label "Reorganisation pattern match shape"@en ;
    rdfs:comment "Warning, not violation: a reorganisation's pattern should agree with its successions, provision transfers and the outcomes of the establishments in them. Added v0.3."@en ;
    sh:targetClass est:EstablishmentReorganisation ;
    sh:severity sh:Warning ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:prefixes <https://dfe-digital.github.io/education-provider-registry-docs/shapes/data-quality/> ;
        sh:message "This reorganisation is recorded as a replacement, but it does not have one establishment that closed and one that opened, linked by a succession."@en ;
        sh:select """
            SELECT $this WHERE {
                $this esto:hasReorganisationPattern est:ReplacementPattern .
                FILTER (
                    EXISTS { $this esto:resultsInProvisionTransfer ?anyTransfer }
                    || EXISTS { { { $this esto:resultsInSuccession/esto:hasPredecessorEstablishment ?giver1 } UNION { $this esto:resultsInProvisionTransfer/esto:hasOriginEstablishment ?giver1 } } { { $this esto:resultsInSuccession/esto:hasPredecessorEstablishment ?giver2 } UNION { $this esto:resultsInProvisionTransfer/esto:hasOriginEstablishment ?giver2 } } FILTER (?giver1 != ?giver2) }
                    || EXISTS { { { $this esto:resultsInSuccession/esto:hasSuccessorEstablishment ?receiver1 } UNION { $this esto:resultsInProvisionTransfer/esto:hasRecipientEstablishment ?receiver1 } } { { $this esto:resultsInSuccession/esto:hasSuccessorEstablishment ?receiver2 } UNION { $this esto:resultsInProvisionTransfer/esto:hasRecipientEstablishment ?receiver2 } } FILTER (?receiver1 != ?receiver2) }
                    || EXISTS { { { $this esto:resultsInSuccession/esto:hasSuccessorEstablishment ?receiver } UNION { $this esto:resultsInProvisionTransfer/esto:hasRecipientEstablishment ?receiver } } FILTER NOT EXISTS { $this esto:hasReorganisationParticipation ?rp . ?rp esto:hasParticipant ?receiver ; esto:hasReorganisationOutcome est:OpenedInReorganisation . } }
                )
            }
        """ ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:prefixes <https://dfe-digital.github.io/education-provider-registry-docs/shapes/data-quality/> ;
        sh:message "This reorganisation is recorded as an absorption, but it does not have successions only, from establishments that closed into one existing establishment that carried on."@en ;
        sh:select """
            SELECT $this WHERE {
                $this esto:hasReorganisationPattern est:AbsorptionPattern .
                FILTER (
                    EXISTS { $this esto:resultsInProvisionTransfer ?anyTransfer }
                    || EXISTS { { { $this esto:resultsInSuccession/esto:hasSuccessorEstablishment ?receiver1 } UNION { $this esto:resultsInProvisionTransfer/esto:hasRecipientEstablishment ?receiver1 } } { { $this esto:resultsInSuccession/esto:hasSuccessorEstablishment ?receiver2 } UNION { $this esto:resultsInProvisionTransfer/esto:hasRecipientEstablishment ?receiver2 } } FILTER (?receiver1 != ?receiver2) }
                    || EXISTS { { { $this esto:resultsInSuccession/esto:hasSuccessorEstablishment ?receiver } UNION { $this esto:resultsInProvisionTransfer/esto:hasRecipientEstablishment ?receiver } } FILTER NOT EXISTS { $this esto:hasReorganisationParticipation ?rp . ?rp esto:hasParticipant ?receiver ; esto:hasReorganisationOutcome est:ContinuedThroughReorganisation . } }
                )
            }
        """ ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:prefixes <https://dfe-digital.github.io/education-provider-registry-docs/shapes/data-quality/> ;
        sh:message "This reorganisation is recorded as an amalgamation, but it does not have successions only, from two or more establishments that closed into one that opened."@en ;
        sh:select """
            SELECT $this WHERE {
                $this esto:hasReorganisationPattern est:AmalgamationPattern .
                FILTER (
                    EXISTS { $this esto:resultsInProvisionTransfer ?anyTransfer }
                    || !EXISTS { { { $this esto:resultsInSuccession/esto:hasPredecessorEstablishment ?giver1 } UNION { $this esto:resultsInProvisionTransfer/esto:hasOriginEstablishment ?giver1 } } { { $this esto:resultsInSuccession/esto:hasPredecessorEstablishment ?giver2 } UNION { $this esto:resultsInProvisionTransfer/esto:hasOriginEstablishment ?giver2 } } FILTER (?giver1 != ?giver2) }
                    || EXISTS { { { $this esto:resultsInSuccession/esto:hasSuccessorEstablishment ?receiver1 } UNION { $this esto:resultsInProvisionTransfer/esto:hasRecipientEstablishment ?receiver1 } } { { $this esto:resultsInSuccession/esto:hasSuccessorEstablishment ?receiver2 } UNION { $this esto:resultsInProvisionTransfer/esto:hasRecipientEstablishment ?receiver2 } } FILTER (?receiver1 != ?receiver2) }
                    || EXISTS { { { $this esto:resultsInSuccession/esto:hasSuccessorEstablishment ?receiver } UNION { $this esto:resultsInProvisionTransfer/esto:hasRecipientEstablishment ?receiver } } FILTER NOT EXISTS { $this esto:hasReorganisationParticipation ?rp . ?rp esto:hasParticipant ?receiver ; esto:hasReorganisationOutcome est:OpenedInReorganisation . } }
                )
            }
        """ ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:prefixes <https://dfe-digital.github.io/education-provider-registry-docs/shapes/data-quality/> ;
        sh:message "This reorganisation is recorded as a split, but it does not have successions only, from one establishment that closed into two or more others."@en ;
        sh:select """
            SELECT $this WHERE {
                $this esto:hasReorganisationPattern est:SplitPattern .
                FILTER (
                    EXISTS { $this esto:resultsInProvisionTransfer ?anyTransfer }
                    || EXISTS { { { $this esto:resultsInSuccession/esto:hasPredecessorEstablishment ?giver1 } UNION { $this esto:resultsInProvisionTransfer/esto:hasOriginEstablishment ?giver1 } } { { $this esto:resultsInSuccession/esto:hasPredecessorEstablishment ?giver2 } UNION { $this esto:resultsInProvisionTransfer/esto:hasOriginEstablishment ?giver2 } } FILTER (?giver1 != ?giver2) }
                    || !EXISTS { { { $this esto:resultsInSuccession/esto:hasSuccessorEstablishment ?receiver1 } UNION { $this esto:resultsInProvisionTransfer/esto:hasRecipientEstablishment ?receiver1 } } { { $this esto:resultsInSuccession/esto:hasSuccessorEstablishment ?receiver2 } UNION { $this esto:resultsInProvisionTransfer/esto:hasRecipientEstablishment ?receiver2 } } FILTER (?receiver1 != ?receiver2) }
                )
            }
        """ ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:prefixes <https://dfe-digital.github.io/education-provider-registry-docs/shapes/data-quality/> ;
        sh:message "This reorganisation is recorded as a spin-out, but it does not have provision transfers only, from one establishment that carried on into establishments that opened."@en ;
        sh:select """
            SELECT $this WHERE {
                $this esto:hasReorganisationPattern est:SpinOutPattern .
                FILTER (
                    EXISTS { $this esto:resultsInSuccession ?anySuccession }
                    || EXISTS { { { $this esto:resultsInSuccession/esto:hasPredecessorEstablishment ?giver1 } UNION { $this esto:resultsInProvisionTransfer/esto:hasOriginEstablishment ?giver1 } } { { $this esto:resultsInSuccession/esto:hasPredecessorEstablishment ?giver2 } UNION { $this esto:resultsInProvisionTransfer/esto:hasOriginEstablishment ?giver2 } } FILTER (?giver1 != ?giver2) }
                    || EXISTS { { { $this esto:resultsInSuccession/esto:hasPredecessorEstablishment ?giver } UNION { $this esto:resultsInProvisionTransfer/esto:hasOriginEstablishment ?giver } } FILTER NOT EXISTS { $this esto:hasReorganisationParticipation ?gp . ?gp esto:hasParticipant ?giver ; esto:hasReorganisationOutcome est:ContinuedThroughReorganisation . } }
                    || EXISTS { { { $this esto:resultsInSuccession/esto:hasSuccessorEstablishment ?receiver } UNION { $this esto:resultsInProvisionTransfer/esto:hasRecipientEstablishment ?receiver } } FILTER NOT EXISTS { $this esto:hasReorganisationParticipation ?rp . ?rp esto:hasParticipant ?receiver ; esto:hasReorganisationOutcome est:OpenedInReorganisation . } }
                )
            }
        """ ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:prefixes <https://dfe-digital.github.io/education-provider-registry-docs/shapes/data-quality/> ;
        sh:message "This reorganisation is recorded as a transfer between continuing establishments, but it does not have provision transfers only, between establishments that all carried on."@en ;
        sh:select """
            SELECT $this WHERE {
                $this esto:hasReorganisationPattern est:TransferBetweenContinuingEstablishmentsPattern .
                FILTER (
                    EXISTS { $this esto:resultsInSuccession ?anySuccession }
                    || EXISTS { { { $this esto:resultsInSuccession/esto:hasPredecessorEstablishment ?giver } UNION { $this esto:resultsInProvisionTransfer/esto:hasOriginEstablishment ?giver } } FILTER NOT EXISTS { $this esto:hasReorganisationParticipation ?gp . ?gp esto:hasParticipant ?giver ; esto:hasReorganisationOutcome est:ContinuedThroughReorganisation . } }
                    || EXISTS { { { $this esto:resultsInSuccession/esto:hasSuccessorEstablishment ?receiver } UNION { $this esto:resultsInProvisionTransfer/esto:hasRecipientEstablishment ?receiver } } FILTER NOT EXISTS { $this esto:hasReorganisationParticipation ?rp . ?rp esto:hasParticipant ?receiver ; esto:hasReorganisationOutcome est:ContinuedThroughReorganisation . } }
                )
            }
        """ ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:prefixes <https://dfe-digital.github.io/education-provider-registry-docs/shapes/data-quality/> ;
        sh:message "This reorganisation is recorded as a complex reorganisation, but it does not have two or more establishments giving provision and two or more receiving it."@en ;
        sh:select """
            SELECT $this WHERE {
                $this esto:hasReorganisationPattern est:ComplexReorganisationPattern .
                FILTER (
                    !EXISTS { { { $this esto:resultsInSuccession/esto:hasPredecessorEstablishment ?giver1 } UNION { $this esto:resultsInProvisionTransfer/esto:hasOriginEstablishment ?giver1 } } { { $this esto:resultsInSuccession/esto:hasPredecessorEstablishment ?giver2 } UNION { $this esto:resultsInProvisionTransfer/esto:hasOriginEstablishment ?giver2 } } FILTER (?giver1 != ?giver2) }
                    || !EXISTS { { { $this esto:resultsInSuccession/esto:hasSuccessorEstablishment ?receiver1 } UNION { $this esto:resultsInProvisionTransfer/esto:hasRecipientEstablishment ?receiver1 } } { { $this esto:resultsInSuccession/esto:hasSuccessorEstablishment ?receiver2 } UNION { $this esto:resultsInProvisionTransfer/esto:hasRecipientEstablishment ?receiver2 } } FILTER (?receiver1 != ?receiver2) }
                )
            }
        """ ;
    ] .

est:ParticipantInPairShape
    a sh:NodeShape ;
    rdfs:label "Participant in pair shape"@en ;
    rdfs:comment "Warning, not violation: every establishment taking part in a reorganisation should give or receive provision in at least one of its successions or provision transfers. Added v0.3."@en ;
    sh:targetClass est:EstablishmentReorganisation ;
    sh:severity sh:Warning ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:prefixes <https://dfe-digital.github.io/education-provider-registry-docs/shapes/data-quality/> ;
        sh:message "{?establishment} takes part in this reorganisation but neither gives nor receives provision in it."@en ;
        sh:select """
            SELECT DISTINCT $this ?establishment WHERE {
                $this esto:hasReorganisationParticipation/esto:hasParticipant ?establishment .
                FILTER NOT EXISTS {
                    {
                        $this esto:resultsInSuccession ?pair .
                        ?pair esto:hasPredecessorEstablishment|esto:hasSuccessorEstablishment ?establishment .
                    } UNION {
                        $this esto:resultsInProvisionTransfer ?pair .
                        ?pair esto:hasOriginEstablishment|esto:hasRecipientEstablishment ?establishment .
                    }
                }
            }
        """ ;
    ] .

est:SuccessorShortcutShape
    a sh:NodeShape ;
    rdfs:label "Successor shortcut shape"@en ;
    rdfs:comment "Warning, not violation: the shortcuts esto:hasSuccessor and esto:hasPredecessor should match a recorded est:Succession. Added v0.3."@en ;
    sh:targetSubjectsOf esto:hasSuccessor, esto:hasPredecessor ;
    sh:severity sh:Warning ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:prefixes <https://dfe-digital.github.io/education-provider-registry-docs/shapes/data-quality/> ;
        sh:message "{?successor} is recorded as a successor of this establishment, but no succession records it."@en ;
        sh:select """
            SELECT $this ?successor WHERE {
                $this esto:hasSuccessor ?successor .
                FILTER NOT EXISTS { ?succession esto:hasPredecessorEstablishment $this ; esto:hasSuccessorEstablishment ?successor . }
            }
        """ ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:prefixes <https://dfe-digital.github.io/education-provider-registry-docs/shapes/data-quality/> ;
        sh:message "{?predecessor} is recorded as a predecessor of this establishment, but no succession records it."@en ;
        sh:select """
            SELECT $this ?predecessor WHERE {
                $this esto:hasPredecessor ?predecessor .
                FILTER NOT EXISTS { ?succession esto:hasPredecessorEstablishment ?predecessor ; esto:hasSuccessorEstablishment $this . }
            }
        """ ;
    ] .
