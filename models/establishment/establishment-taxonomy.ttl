    a skos:Concept ;
    skos:inScheme est:establishmentDetailsTaxonomy ;
    skos:prefLabel "Community school"@en ;
    skos:broader est:EstablishmentTypeGroupLaMaintainedSchools ;
    dcterms:source "Type code 01"@en ;
    est:status "Provisional"@en .

est:VoluntaryAidedSchool
    a skos:Concept ;
    skos:inScheme est:establishmentDetailsTaxonomy ;
    skos:prefLabel "Voluntary aided school"@en ;
    skos:broader est:EstablishmentTypeGroupLaMaintainedSchools ;
    dcterms:source "Type code 02"@en ;
    est:status "Provisional"@en .

est:VoluntaryControlledSchool
    a skos:Concept ;
    skos:inScheme est:establishmentDetailsTaxonomy ;
    skos:prefLabel "Voluntary controlled school"@en ;
    skos:broader est:EstablishmentTypeGroupLaMaintainedSchools ;
    dcterms:source "Type code 03"@en ;
    est:status "Provisional"@en .

est:FoundationSchool
    a skos:Concept ;
    skos:inScheme est:establishmentDetailsTaxonomy ;
    skos:prefLabel "Foundation school"@en ;
    skos:broader est:EstablishmentTypeGroupLaMaintainedSchools ;
    dcterms:source "Type code 05"@en ;
    est:status "Provisional"@en .

est:CommunitySpecialSchool
    a skos:Concept ;
    skos:inScheme est:establishmentDetailsTaxonomy ;
    skos:prefLabel "Community special school"@en ;
    skos:broader est:EstablishmentTypeGroupLaMaintainedSchools ;
    dcterms:source "Type code 07"@en ;
    est:status "Provisional"@en .

est:FoundationSpecialSchool
    a skos:Concept ;
    skos:inScheme est:establishmentDetailsTaxonomy ;
    skos:prefLabel "Foundation special school"@en ;
    skos:broader est:EstablishmentTypeGroupLaMaintainedSchools ;
    dcterms:source "Type code 12"@en ;
    est:status "Provisional"@en .

est:PupilReferralUnit
    a skos:Concept ;
    skos:inScheme est:establishmentDetailsTaxonomy ;
    skos:prefLabel "Pupil referral unit"@en ;
    skos:altLabel "PRU"@en ;
    skos:broader est:EstablishmentTypeGroupLaMaintainedSchools ;
    dcterms:source "Type code 14"@en ;
    est:status "Provisional"@en .

est:MaintainedNurserySchool
    a skos:Concept ;
    skos:inScheme est:establishmentDetailsTaxonomy ;
    skos:prefLabel "Maintained nursery school"@en ;
    skos:broader est:EstablishmentTypeGroupLaMaintainedSchools ;
    dcterms:source "Type code 15"@en ;
    est:status "Provisional"@en .

#################################################################
# Establishment-type taxons - group 5: non-maintained special schools
#################################################################

est:NonMaintainedSpecialSchool
    a skos:Concept ;
    skos:inScheme est:establishmentDetailsTaxonomy ;
    skos:prefLabel "Non-maintained special school"@en ;
    skos:broader est:EstablishmentTypeGroupNonMaintainedSpecialSchools ;
    dcterms:source "Type code 08"@en ;
    est:status "Provisional"@en .

est:OtherIndependentSpecialSchool
    a skos:Concept ;
    skos:inScheme est:establishmentDetailsTaxonomy ;
    skos:prefLabel "Other independent special school"@en ;
    skos:scopeNote "GIAS construct. Residual category for independent schools providing special education that are not non-maintained special schools. The 'other' qualifier has no equivalent in legislation or GOV.UK guidance."@en ;
    skos:broader est:EstablishmentTypeGroupNonMaintainedSpecialSchools ;
    dcterms:source "Type code 10"@en ;
    est:status "Provisional"@en .

#################################################################
# Establishment-type taxons - group 3: independent schools
#################################################################

est:CityTechnologyCollege
    a skos:Concept ;
    skos:inScheme est:establishmentDetailsTaxonomy ;
    skos:prefLabel "City technology college"@en ;
    skos:altLabel "CTC"@en ;
    skos:broader est:EstablishmentTypeGroupIndependentSchools ;
    dcterms:source "Type code 06"@en ;
    est:status "Provisional"@en .

est:OtherIndependentSchool
    a skos:Concept ;
    skos:inScheme est:establishmentDetailsTaxonomy ;
    skos:prefLabel "Other independent school"@en ;
    skos:broader est:EstablishmentTypeGroupIndependentSchools ;
    dcterms:source "Type code 11"@en ;
    est:status "Provisional"@en .

#################################################################
# Establishment-type taxons - group 1: colleges
#################################################################

est:FurtherEducation
    a skos:Concept ;
    skos:inScheme est:establishmentDetailsTaxonomy ;
    skos:prefLabel "Further education"@en ;
    skos:altLabel "Further education college"@en ;
    skos:broader est:EstablishmentTypeGroupColleges ;
    dcterms:source "Type code 18"@en ;
    est:status "Provisional"@en .

est:SixthFormCentre
    a skos:Concept ;
    skos:inScheme est:establishmentDetailsTaxonomy ;
    skos:prefLabel "Sixth form centre"@en ;
    skos:scopeNote "Real-world (limited). LA sixth form arrangements pre-2010; most are closed. No current GOV.UK policy page defines this as an active establishment type."@en ;
    skos:broader est:EstablishmentTypeGroupColleges ;
    dcterms:source "Type code 31"@en ;
    est:status "Provisional"@en .

#################################################################
# Establishment-type taxons - group 2: universities
#################################################################

est:HigherEducationInstitution
    a skos:Concept ;
    skos:inScheme est:establishmentDetailsTaxonomy ;
    skos:prefLabel "Higher education institution"@en ;
    skos:altLabel "HEI"@en ;
    skos:broader est:EstablishmentTypeGroupUniversities ;
    dcterms:source "Type code 29"@en ;
    est:status "Provisional"@en .

#################################################################
# Establishment-type taxons - group 6: Welsh establishments
#################################################################

est:WelshEstablishment
    a skos:Concept ;
    skos:inScheme est:establishmentDetailsTaxonomy ;
    skos:prefLabel "Welsh establishment"@en ;
    skos:scopeNote "GIAS construct. Administrative category for schools in Wales appearing in DfE data for cross-border purposes. Welsh school types are governed by Senedd Cymru and are not defined on GOV.UK."@en ;
    skos:broader est:EstablishmentTypeGroupWelshEstablishments ;
    dcterms:source "Type code 30"@en ;
    est:status "Provisional"@en .

#################################################################
# Establishment-type taxons - other types
#################################################################

est:SecureUnits
    a skos:Concept ;
    skos:inScheme est:establishmentDetailsTaxonomy ;
    skos:prefLabel "Secure units"@en ;
    skos:scopeNote "Real-world (limited). Secure residential facilities with education provision are real and referenced on GOV.UK, but 'Secure units' as an establishment type label is a GIAS administrative grouping, not a GOV.UK-defined term."@en ;
    skos:broader est:EstablishmentTypeGroupOtherTypes ;
    dcterms:source "Type code 24"@en ;
    est:status "Provisional"@en .

est:OffshoreSchools
    a skos:Concept ;
    skos:inScheme est:establishmentDetailsTaxonomy ;
    skos:prefLabel "Offshore schools"@en ;
    skos:scopeNote "Real-world (limited). Schools in Crown Dependencies (Jersey, Guernsey, Isle of Man) and Gibraltar assigned DfE reference numbers because they follow the English curriculum. 'Offshore schools' is a GIAS administrative grouping, not a statutory term."@en ;
    skos:broader est:EstablishmentTypeGroupOtherTypes ;
    dcterms:source "Type code 25"@en ;
    est:status "Provisional"@en .

est:ServiceChildrensEducation
    a skos:Concept ;
    skos:inScheme est:establishmentDetailsTaxonomy ;
    skos:prefLabel "Service children's education"@en ;
    skos:broader est:EstablishmentTypeGroupOtherTypes ;
    dcterms:source "Type code 26"@en ;
    est:status "Provisional"@en .

est:MiscellaneousEstablishment
    a skos:Concept ;
    skos:inScheme est:establishmentDetailsTaxonomy ;
    skos:prefLabel "Miscellaneous"@en ;
    skos:scopeNote "GIAS construct. An explicit catch-all for establishments that do not fit any other type code. No GOV.UK definition."@en ;
    skos:broader est:EstablishmentTypeGroupOtherTypes ;
    dcterms:source "Type code 27"@en ;
    est:status "Provisional"@en .

est:SpecialPost16Institution
    a skos:Concept ;
    skos:inScheme est:establishmentDetailsTaxonomy ;
    skos:prefLabel "Special post 16 institution"@en ;
    skos:broader est:EstablishmentTypeGroupOtherTypes ;
    dcterms:source "Type code 32"@en ;
    est:status "Provisional"@en .

est:BritishSchoolsOverseas
    a skos:Concept ;
    skos:inScheme est:establishmentDetailsTaxonomy ;
    skos:prefLabel "British schools overseas"@en ;
    skos:altLabel "BSO"@en ;
    skos:broader est:EstablishmentTypeGroupOtherTypes ;
    dcterms:source "Type code 37"@en ;
    est:status "Provisional"@en .

est:InstitutionFundedByOtherGovernmentDepartment
    a skos:Concept ;
    skos:inScheme est:establishmentDetailsTaxonomy ;
    skos:prefLabel "Institution funded by other government department"@en ;
    skos:scopeNote "GIAS construct. Administrative label for establishments funded by a government department other than DfE (e.g. MOD, Home Office). Not defined on GOV.UK as an establishment type."@en ;
    skos:broader est:EstablishmentTypeGroupOtherTypes ;
    dcterms:source "Type code 56"@en ;
    est:status "Provisional"@en .

#################################################################
# Establishment-type taxons - group 10: academies
#################################################################

est:MainstreamAcademy
    a skos:Concept ;
    skos:inScheme est:establishmentDetailsTaxonomy ;
    skos:prefLabel "Mainstream academy"@en ;
    skos:broader est:EstablishmentTypeGroupAcademies ;
    est:status "Preferred"@en .

est:AcademySpecial
    a skos:Concept ;
    skos:inScheme est:establishmentDetailsTaxonomy ;
    skos:prefLabel "Academy special school"@en ;
    skos:broader est:EstablishmentTypeGroupAcademies ;
    est:status "Preferred"@en .

est:AcademyAlternativeProvision
    a skos:Concept ;
    skos:inScheme est:establishmentDetailsTaxonomy ;
    skos:prefLabel "Academy alternative provision"@en ;
    skos:broader est:EstablishmentTypeGroupAcademies ;
    est:status "Preferred"@en .

est:Academy1619
    a skos:Concept ;
    skos:inScheme est:establishmentDetailsTaxonomy ;
    skos:prefLabel "Academy 16 to 19"@en ;
    skos:broader est:EstablishmentTypeGroupAcademies ;
    est:status "Preferred"@en .

est:AcademySecure16To19
    a skos:Concept ;
    skos:inScheme est:establishmentDetailsTaxonomy ;
    skos:prefLabel "Academy secure 16 to 19"@en ;
    skos:scopeNote "Real-world (limited). Named within academy type listings but no dedicated GOV.UK guidance page. Secure 16-19 academies (young people in custodial settings aged 16–19 under a funding agreement) are a real concept. Restricted public Details view: only 17 fields publicly visible."@en ;
    skos:broader est:EstablishmentTypeGroupAcademies ;
    dcterms:source "Type code 57"@en ;
    est:status "Provisional"@en .

