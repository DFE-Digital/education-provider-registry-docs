@prefix est: <https://dfe-digital.github.io/education-provider-registry-docs/models/establishment/vocabulary/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Education Provider Registry Taxonomy
#
# Scope: this version covers classifications used by the fields shown in the
# establishment record Details tab in the public view.
#
# Facets are represented as top concepts. Taxons are narrower concepts beneath
# their facet. Establishment types are represented as taxons under
# EstablishmentType, with an intermediate type-group level. Dates, identifiers,
# measures and organisation relationships are excluded because they are not
# taxonomy classifications.
#
# It is not a complete provider-domain taxonomy and does not attempt to classify
# fields outside the establishment record Details tab.


est:establishmentDetailsTaxonomy
    a skos:ConceptScheme ;
    dcterms:title "Education Provider Registry Taxonomy"@en ;
    dcterms:description "Faceted taxonomy containing classifications used by the fields shown in the establishment record Details tab in the public view."@en ;
    dcterms:created "2026-06-16"^^xsd:date ;
    dcterms:modified "2026-06-24"^^xsd:date ;
    est:status "Provisional"@en ;
    skos:hasTopConcept
        est:EstablishmentType,
        est:EducationPhase,
        est:EstablishmentStatus,
        est:AdmissionsPolicy,
        est:GenderOfEntry,
        est:BoardingProvision,
        est:NurseryProvision,
        est:SixthFormProvision,
        est:SpecialClassProvision,
        est:ReligiousCharacter,
        est:ReligiousEthos,
        est:EstablishmentGroupType,
        est:GroupRelationshipType .

#################################################################
# Facet collection
#################################################################

est:establishmentDetailsTaxonomyFacets
    a skos:Collection ;
    skos:prefLabel "Education provider taxonomy facets"@en ;
    skos:member
        est:EstablishmentType,
        est:EducationPhase,
        est:EstablishmentStatus,
        est:AdmissionsPolicy,
        est:GenderOfEntry,
        est:BoardingProvision,
        est:NurseryProvision,
        est:SixthFormProvision,
        est:SpecialClassProvision,
        est:ReligiousCharacter,
        est:ReligiousEthos,
        est:EstablishmentGroupType,
        est:GroupRelationshipType .

#################################################################
# Type-group collection
#################################################################

est:establishmentTypeGroups
    a skos:Collection ;
    skos:prefLabel "Establishment type groups"@en ;
    skos:member
        est:EstablishmentTypeGroupColleges,
        est:EstablishmentTypeGroupUniversities,
        est:EstablishmentTypeGroupIndependentSchools,
        est:EstablishmentTypeGroupLaMaintainedSchools,
        est:EstablishmentTypeGroupNonMaintainedSpecialSchools,
        est:EstablishmentTypeGroupWelshEstablishments,
        est:EstablishmentTypeGroupOtherTypes,
        est:EstablishmentTypeGroupAcademies,
        est:EstablishmentTypeGroupFreeSchools,
        est:EstablishmentTypeGroupChildrensCentres,
        est:EstablishmentTypeGroupOnlineProviders .

#################################################################
# Facets
#################################################################

est:EstablishmentType
    a skos:Concept ;
    skos:inScheme est:establishmentDetailsTaxonomy ;
    skos:topConceptOf est:establishmentDetailsTaxonomy ;
    skos:prefLabel "Establishment type"@en ;
    skos:definition "The legal, operational or policy classification recorded as the establishment's type."@en ;
    skos:scopeNote "This remains an overloaded legacy classification mixing legal form, sector and operational model. The intermediate type-group level is retained for traceability."@en ;
    skos:narrower
        est:EstablishmentTypeGroupAcademies,
        est:EstablishmentTypeGroupChildrensCentres,
        est:EstablishmentTypeGroupColleges,
        est:EstablishmentTypeGroupFreeSchools,
        est:EstablishmentTypeGroupIndependentSchools,
        est:EstablishmentTypeGroupLaMaintainedSchools,
        est:EstablishmentTypeGroupNonMaintainedSpecialSchools,
        est:EstablishmentTypeGroupOnlineProviders,
        est:EstablishmentTypeGroupOtherTypes,
        est:EstablishmentTypeGroupUniversities,
        est:EstablishmentTypeGroupWelshEstablishments ;
    est:status "Provisional"@en .

est:EducationPhase
    a skos:Concept ;
    skos:inScheme est:establishmentDetailsTaxonomy ;
    skos:topConceptOf est:establishmentDetailsTaxonomy ;
    skos:prefLabel "Education phase"@en ;
    skos:definition "The broad stage of education provided by an establishment."@en ;
    skos:narrower
        est:NurseryPhase,
        est:PrimaryPhase,
        est:MiddlePhase,
        est:MiddleDeemedSecondaryPhase,
        est:SecondaryPhase,
        est:AllThroughPhase,
        est:SixteenToNineteenPhase,
        est:NotApplicableEducationPhase ;
    est:status "Provisional"@en .

est:EstablishmentStatus
    a skos:Concept ;
    skos:inScheme est:establishmentDetailsTaxonomy ;
    skos:topConceptOf est:establishmentDetailsTaxonomy ;
    skos:prefLabel "Establishment status"@en ;
    skos:definition "The current lifecycle or operating-state classification of an establishment."@en ;
    skos:narrower
        est:OpenStatus,
        est:ClosedStatus,
        est:OpenProposedToCloseStatus,
        est:ProposedToOpenStatus ;
    est:status "Provisional"@en .

est:AdmissionsPolicy
    a skos:Concept ;
    skos:inScheme est:establishmentDetailsTaxonomy ;
    skos:topConceptOf est:establishmentDetailsTaxonomy ;
    skos:prefLabel "Admissions policy"@en ;
    skos:definition "The classification describing how places are allocated."@en ;
    skos:narrower
        est:SelectiveAdmissions,
        est:NonSelectiveAdmissions,
        est:NotApplicableAdmissionsPolicy ;
    est:status "Provisional"@en .

est:GenderOfEntry
    a skos:Concept ;
    skos:inScheme est:establishmentDetailsTaxonomy ;
    skos:topConceptOf est:establishmentDetailsTaxonomy ;
    skos:prefLabel "Gender of entry"@en ;
    skos:definition "The classification describing the establishment's gender admission arrangement."@en ;
    skos:narrower
        est:BoysOnlyGenderEntry,
        est:GirlsOnlyGenderEntry,
        est:MixedGenderEntry,
        est:NotApplicableGenderOfEntry ;
    est:status "Provisional"@en .

est:BoardingProvision
    a skos:Concept ;
    skos:inScheme est:establishmentDetailsTaxonomy ;
    skos:topConceptOf est:establishmentDetailsTaxonomy ;
    skos:prefLabel "Boarding provision"@en ;
    skos:definition "The classification describing whether boarding places are offered."@en ;
    skos:narrower
        est:BoardingSchool,
        est:HasBoarders,
        est:NoBoarders ;
    est:status "Provisional"@en .

est:NurseryProvision
    a skos:Concept ;
    skos:inScheme est:establishmentDetailsTaxonomy ;
    skos:topConceptOf est:establishmentDetailsTaxonomy ;
    skos:prefLabel "Nursery provision"@en ;
    skos:definition "The classification describing whether the establishment offers nursery classes."@en ;
    skos:narrower
        est:HasNurseryClasses,
        est:NoNurseryClasses,
        est:NotApplicableNurseryProvision ;
    est:status "Provisional"@en .

est:SixthFormProvision
    a skos:Concept ;
    skos:inScheme est:establishmentDetailsTaxonomy ;
    skos:topConceptOf est:establishmentDetailsTaxonomy ;
    skos:prefLabel "Sixth-form provision"@en ;
    skos:definition "The classification describing whether the establishment has a sixth form."@en ;
    skos:narrower
        est:HasSixthForm,
        est:NoSixthForm,
        est:NotApplicableSixthFormProvision ;
    est:status "Provisional"@en .

est:SpecialClassProvision
    a skos:Concept ;
    skos:inScheme est:establishmentDetailsTaxonomy ;
    skos:topConceptOf est:establishmentDetailsTaxonomy ;
    skos:prefLabel "Special-class provision"@en ;
    skos:definition "The classification describing whether the establishment has special classes."@en ;
    skos:narrower
        est:HasSpecialClasses,
        est:NoSpecialClasses,
        est:NotApplicableSpecialClassProvision ;
    est:status "Provisional"@en .

est:ReligiousCharacter
    a skos:Concept ;
    skos:inScheme est:establishmentDetailsTaxonomy ;
    skos:topConceptOf est:establishmentDetailsTaxonomy ;
    skos:prefLabel "Religious character"@en ;
    skos:definition "The formal religious-character classification designated for an establishment."@en ;
    skos:narrower
        est:ChurchOfEnglandCharacter,
        est:JewishCharacter,
        est:MuslimCharacter,
        est:NoReligiousCharacter,
        est:NotApplicableReligiousCharacter,
        est:OtherReligiousCharacter,
        est:RomanCatholicCharacter ;
    est:status "Provisional"@en .

est:ReligiousEthos
    a skos:Concept ;
    skos:inScheme est:establishmentDetailsTaxonomy ;
    skos:topConceptOf est:establishmentDetailsTaxonomy ;
    skos:prefLabel "Religious ethos"@en ;
    skos:definition "The recorded religious-ethos classification associated with an establishment."@en ;
    skos:scopeNote "Its distinction from religious character requires business validation."@en ;
    skos:narrower
        est:ChristianEthos,
        est:NoReligiousEthos,
        est:NotApplicableReligiousEthos,
        est:OtherReligiousEthos ;
    est:status "Provisional"@en .

#################################################################
# Establishment type groups
#################################################################

est:EstablishmentTypeGroupColleges
    a skos:Concept ;
    skos:inScheme est:establishmentDetailsTaxonomy ;
    skos:prefLabel "Colleges"@en ;
    skos:altLabel "Further education colleges"@en ;
    skos:definition "The GIAS establishment type group covering further and sixth-form education colleges."@en ;
    skos:broader est:EstablishmentType ;
    skos:narrower
        est:FurtherEducation,
        est:SixthFormCentre ;
    est:status "Provisional"@en .

est:EstablishmentTypeGroupUniversities
    a skos:Concept ;
    skos:inScheme est:establishmentDetailsTaxonomy ;
    skos:prefLabel "Universities and higher education"@en ;
    skos:altLabel "HEI"@en ;
    skos:definition "The GIAS establishment type group covering higher education institutions."@en ;
    skos:broader est:EstablishmentType ;
    skos:narrower
        est:HigherEducationInstitution ;
    est:status "Provisional"@en .

est:EstablishmentTypeGroupIndependentSchools
    a skos:Concept ;
    skos:inScheme est:establishmentDetailsTaxonomy ;
    skos:prefLabel "Independent schools"@en ;
    skos:definition "The GIAS establishment type group covering city technology colleges and other independent schools."@en ;
    skos:broader est:EstablishmentType ;
    skos:narrower
        est:CityTechnologyCollege,
        est:OtherIndependentSchool ;
    est:status "Provisional"@en .

est:EstablishmentTypeGroupLaMaintainedSchools
    a skos:Concept ;
    skos:inScheme est:establishmentDetailsTaxonomy ;
    skos:prefLabel "Local authority maintained schools"@en ;
    skos:altLabel "LA maintained schools"@en ;
    skos:definition "The GIAS establishment type group covering schools maintained by a local authority."@en ;
    skos:broader est:EstablishmentType ;
    skos:narrower
        est:CommunitySchool,
        est:VoluntaryAidedSchool,
        est:VoluntaryControlledSchool,
        est:FoundationSchool,
        est:CommunitySpecialSchool,
        est:FoundationSpecialSchool,
        est:PupilReferralUnit,
        est:MaintainedNurserySchool ;
    est:status "Provisional"@en .

est:EstablishmentTypeGroupNonMaintainedSpecialSchools
    a skos:Concept ;
    skos:inScheme est:establishmentDetailsTaxonomy ;
    skos:prefLabel "Non-maintained special schools"@en ;
    skos:definition "The GIAS establishment type group covering non-maintained and independent special schools."@en ;
    skos:broader est:EstablishmentType ;
    skos:narrower
        est:NonMaintainedSpecialSchool,
        est:OtherIndependentSpecialSchool ;
