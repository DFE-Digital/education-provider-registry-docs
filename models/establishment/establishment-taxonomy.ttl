est:EstablishmentTypeGroupFreeSchools
    a skos:Concept ;
    skos:inScheme est:establishmentDetailsTaxonomy ;
    skos:prefLabel "Free schools (type group)"@en ;
    skos:altLabel "Free schools"@en ;
    skos:definition "The GIAS establishment type group covering all free school types."@en ;
    skos:broader est:EstablishmentType ;
    skos:narrower
        est:FreeSchool,
        est:FreeSchoolSpecial,
        est:FreeSchoolAlternativeProvision,
        est:FreeSchool16To19,
        est:UniversityTechnicalCollege,
        est:StudioSchool ;
    est:status "Provisional"@en .

est:EstablishmentTypeGroupChildrensCentres
    a skos:Concept ;
    skos:inScheme est:establishmentDetailsTaxonomy ;
    skos:prefLabel "Children's centres"@en ;
    skos:definition "The GIAS establishment type group covering children's centres."@en ;
    skos:broader est:EstablishmentType ;
    skos:narrower
        est:ChildrensCentre ;
    est:status "Provisional"@en .

est:EstablishmentTypeGroupOnlineProviders
    a skos:Concept ;
    skos:inScheme est:establishmentDetailsTaxonomy ;
    skos:prefLabel "Online providers"@en ;
    skos:definition "The GIAS establishment type group covering online education providers."@en ;
    skos:broader est:EstablishmentType ;
    skos:narrower
        est:OnlineProvider ;
    est:status "Provisional"@en .

