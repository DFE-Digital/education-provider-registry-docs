est:EstablishmentTypeGroupWelshEstablishments
    a skos:Concept ;
    skos:inScheme est:establishmentDetailsTaxonomy ;
    skos:prefLabel "Welsh establishments"@en ;
    skos:definition "The GIAS establishment type group covering establishments in Wales."@en ;
    skos:broader est:EstablishmentType ;
    skos:narrower
        est:WelshEstablishment ;
    est:status "Provisional"@en .

est:EstablishmentTypeGroupOtherTypes
    a skos:Concept ;
    skos:inScheme est:establishmentDetailsTaxonomy ;
    skos:prefLabel "Other types"@en ;
    skos:altLabel "Miscellaneous"@en ;
    skos:definition "The GIAS establishment type group covering miscellaneous and other establishment types."@en ;
    skos:broader est:EstablishmentType ;
    skos:narrower
        est:SecureUnits,
        est:OffshoreSchools,
        est:ServiceChildrensEducation,
        est:MiscellaneousEstablishment,
        est:SpecialPost16Institution,
        est:BritishSchoolsOverseas,
        est:InstitutionFundedByOtherGovernmentDepartment ;
    est:status "Provisional"@en .

est:EstablishmentTypeGroupAcademies
    a skos:Concept ;
    skos:inScheme est:establishmentDetailsTaxonomy ;
    skos:prefLabel "Academies"@en ;
    skos:definition "The GIAS establishment type group covering all academy types."@en ;
    skos:broader est:EstablishmentType ;
    skos:narrower
        est:AcademySponsorLed,
        est:AcademySpecialSponsorLed,
        est:AcademyConverter,
        est:AcademyAlternativeProvisionConverter,
        est:AcademyAlternativeProvisionSponsorLed,
        est:AcademySpecialConverter,
        est:Academy1619Converter,
        est:Academy16To19SponsorLed,
        est:AcademySecure16To19 ;
