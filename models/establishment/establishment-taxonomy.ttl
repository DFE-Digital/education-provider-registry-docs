#################################################################
# Establishment-group-type facet (v1.1)
#################################################################

est:EstablishmentGroupType
    a skos:Concept ;
    skos:inScheme est:establishmentDetailsTaxonomy ;
    skos:topConceptOf est:establishmentDetailsTaxonomy ;
    skos:prefLabel "Establishment group type"@en ;
    skos:definition "The classification of an establishment group by its type, corresponding to EstablishmentGroupType codes in GIAS."@en ;
    skos:scopeNote "Active group types only (codes 01, 02, 05, 06, 08, 09, 10, 11). Three archived group types are intentionally excluded. Code 03 (Collegiate) and code 04 (Partnership) have no rows in current GIAS data and no public service representation. Code 07 (Umbrella trust) has approximately 20 legacy rows in current data but does not render a public group details page on the GIAS service; it is retained in the data for historical continuity only."@en ;
    skos:narrower
        est:Federation,
        est:GenericTrust,
        est:SchoolSponsor,
        est:MultiAcademyTrust,
        est:ChildrensCentreGroup,
        est:ChildrensCentreCollaboration,
        est:SingleAcademyTrust,
        est:SecureSingleAcademyTrust ;
    est:status "Provisional"@en .

est:Federation
    a skos:Concept ;
    skos:inScheme est:establishmentDetailsTaxonomy ;
    skos:prefLabel "Federation"@en ;
    skos:broader est:EstablishmentGroupType ;
    dcterms:source "Group type code 01"@en ;
    est:status "Provisional"@en .

est:GenericTrust
    a skos:Concept ;
    skos:inScheme est:establishmentDetailsTaxonomy ;
    skos:prefLabel "Trust"@en ;
    skos:scopeNote "GIAS construct. Legacy group type code 02, rarely used and retained for completeness. Not separately defined on GOV.UK."@en ;
    skos:broader est:EstablishmentGroupType ;
    dcterms:source "Group type code 02"@en ;
    est:status "Provisional"@en .

est:SchoolSponsor
    a skos:Concept ;
    skos:inScheme est:establishmentDetailsTaxonomy ;
    skos:prefLabel "School sponsor"@en ;
    dcterms:source "Group type code 05"@en ;
    est:status "Legacy"@en ;
    skos:scopeNote "GIAS group type 05. In the target EPR model, the sponsoring body is modelled as an est:Organisation linked via esto:sponsoredBy on est:Establishment. Sponsor is a role an organisation plays, not a type of establishment group."@en .

est:MultiAcademyTrust
    a skos:Concept ;
    skos:inScheme est:establishmentDetailsTaxonomy ;
    skos:prefLabel "Multi-academy trust"@en ;
    skos:altLabel "MAT"@en ;
    skos:broader est:EstablishmentGroupType ;
    dcterms:source "Group type code 06"@en ;
    est:status "Provisional"@en .

est:ChildrensCentreGroup
    a skos:Concept ;
    skos:inScheme est:establishmentDetailsTaxonomy ;
    skos:prefLabel "Children's centres group"@en ;
    skos:scopeNote "GIAS construct. Administrative grouping for children's centre cluster arrangements. Not defined on GOV.UK as a group type."@en ;
    skos:broader est:EstablishmentGroupType ;
    dcterms:source "Group type code 08"@en ;
    est:status "Provisional"@en .

est:ChildrensCentreCollaboration
    a skos:Concept ;
    skos:inScheme est:establishmentDetailsTaxonomy ;
    skos:prefLabel "Children's centres collaboration"@en ;
    skos:scopeNote "GIAS construct. Administrative grouping for cross-group children's centre arrangements. Not defined on GOV.UK as a group type."@en ;
    skos:broader est:EstablishmentGroupType ;
    dcterms:source "Group type code 09"@en ;
    est:status "Provisional"@en .

est:SingleAcademyTrust
    a skos:Concept ;
    skos:inScheme est:establishmentDetailsTaxonomy ;
    skos:prefLabel "Single-academy trust"@en ;
    skos:altLabel "SAT"@en ;
    skos:broader est:EstablishmentGroupType ;
    dcterms:source "Group type code 10"@en ;
    est:status "Provisional"@en .

est:SecureSingleAcademyTrust
    a skos:Concept ;
    skos:inScheme est:establishmentDetailsTaxonomy ;
    skos:prefLabel "Secure single-academy trust"@en ;
    skos:scopeNote "GIAS construct. A sub-type for a SAT operating an Academy secure 16 to 19. Not separately named or defined on GOV.UK."@en ;
    skos:broader est:EstablishmentGroupType ;
    dcterms:source "Group type code 11"@en ;
    est:status "Provisional"@en .

