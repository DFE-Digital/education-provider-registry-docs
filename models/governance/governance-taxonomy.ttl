# Governance taxonomy
#
# Scope: controlled classifications used by the governance business domain.
#
# The flat governance vocabulary defines business nouns. This taxonomy defines
# the values used to classify instances of those concepts. Person, organisation,
# membership, appointment, term, role assignment, record and event concepts are
# therefore not used as taxonomy values.
#
# The taxonomy is informed by GovernorHub's externally observable business
# model and authoritative real-world governance sources. It is not a copy of
# GovernorHub's private implementation or product administration model.
#
# Facets are independent. In particular, appointment type, appointing party,
# governance role, constitution position category and lifecycle status must not
# be treated as interchangeable classifications.

gov:evidenceStatus
    a rdf:Property ;
    rdfs:label "Evidence status"@en ;
    rdfs:comment "The evidence status supporting a taxonomic assertion."@en .

gov:valueControl
    a rdf:Property ;
    rdfs:label "Value control"@en ;
    rdfs:comment "Whether a classification value is fixed, configurable or unresolved in the observed source."@en .

gov:governanceTaxonomy
    a skos:ConceptScheme ;
    dcterms:title "Governance Taxonomy"@en ;
    dcterms:description "Faceted taxonomy of controlled governance classifications, informed by GovernorHub and authoritative real-world governance sources."@en ;
    dcterms:created "2026-07-27"^^xsd:date ;
    dcterms:modified "2026-07-28"^^xsd:date ;
    gov:status "Provisional"@en ;
    skos:hasTopConcept
