    skos:prefLabel "Governor"@en ;
    skos:broader gov:GovernanceParticipantType, gov:StatutoryGovernanceAppointment ;
    gov:status "Provisional"@en .

gov:GovernorType
    a skos:Concept ; skos:inScheme gov:governanceTaxonomy ;
    skos:prefLabel "Governor type"@en ;
    skos:broader gov:GovernanceParticipantType ;
    gov:status "Provisional"@en .

gov:CoOptedGovernor
    a skos:Concept ; skos:inScheme gov:governanceTaxonomy ;
    skos:prefLabel "Co-opted governor"@en ;
    skos:broader gov:GovernanceParticipantType, gov:StatutoryGovernanceAppointment ;
    gov:status "Provisional"@en .

gov:ExOfficioGovernor
    a skos:Concept ; skos:inScheme gov:governanceTaxonomy ;
    skos:prefLabel "Ex-officio governor"@en ;
    skos:broader gov:GovernanceParticipantType, gov:StatutoryGovernanceAppointment ;
    gov:status "Provisional"@en .

gov:FoundationGovernor
    a skos:Concept ; skos:inScheme gov:governanceTaxonomy ;
