    skos:prefLabel "Local authority governor"@en ;
    skos:broader gov:GovernanceParticipantType, gov:StatutoryGovernanceAppointment ;
    gov:status "Provisional"@en .

gov:LocalGovernor
    a skos:Concept ; skos:inScheme gov:governanceTaxonomy ;
    skos:prefLabel "Local governor"@en ;
    skos:broader gov:GovernanceParticipantType, gov:StatutoryGovernanceAppointment ;
    gov:status "Provisional"@en .

gov:ParentGovernor
    a skos:Concept ; skos:inScheme gov:governanceTaxonomy ;
    skos:prefLabel "Parent governor"@en ;
    skos:broader gov:GovernanceParticipantType, gov:StatutoryGovernanceAppointment ;
    gov:status "Provisional"@en .

gov:PartnershipGovernor
    a skos:Concept ; skos:inScheme gov:governanceTaxonomy ;
    skos:prefLabel "Partnership governor"@en ;
    skos:broader gov:GovernanceParticipantType, gov:StatutoryGovernanceAppointment ;
    gov:status "Provisional"@en .

gov:StaffGovernor
    a skos:Concept ; skos:inScheme gov:governanceTaxonomy ;
    skos:prefLabel "Staff governor"@en ;
    skos:broader gov:GovernanceParticipantType, gov:StatutoryGovernanceAppointment ;
    gov:status "Provisional"@en .

gov:AssociateGovernor
    a skos:Concept ; skos:inScheme gov:governanceTaxonomy ;
    skos:prefLabel "Associate governor"@en ;
    skos:broader gov:GovernanceParticipantType, gov:StatutoryGovernanceAppointment ;
    skos:related gov:BoardMember ;
    gov:status "Provisional"@en .

gov:BoardMember
    a skos:Concept ; skos:inScheme gov:governanceTaxonomy ;
    skos:prefLabel "Board member"@en ;
    skos:broader gov:GovernanceParticipantType, gov:StatutoryGovernanceAppointment ;
    gov:status "Provisional"@en .

gov:LocalGoverningBodyMember
    a skos:Concept ; skos:inScheme gov:governanceTaxonomy ;
    skos:prefLabel "Local governing body member"@en ;
    skos:broader gov:GovernanceParticipantType, gov:DelegatedGovernanceAppointment ;
    gov:status "Provisional"@en .

gov:Trustee
    a skos:Concept ; skos:inScheme gov:governanceTaxonomy ;
    skos:prefLabel "Trustee"@en ;
    skos:broader gov:GovernanceParticipantType, gov:DelegatedGovernanceAppointment ;
    skos:related gov:CompanyDirector, gov:Director ;
    gov:status "Provisional"@en .

gov:AcademyTrustee
    a skos:Concept ; skos:inScheme gov:governanceTaxonomy ;
    skos:prefLabel "Academy trustee"@en ;
    skos:broader gov:GovernanceParticipantType, gov:DelegatedGovernanceAppointment ;
    skos:related gov:CompanyDirector, gov:Director ;
    gov:status "Provisional"@en .

gov:AcademyTrustMember
    a skos:Concept ; skos:inScheme gov:governanceTaxonomy ;
    skos:prefLabel "Academy trust member"@en ;
    skos:broader gov:GovernanceParticipantType, gov:DelegatedGovernanceAppointment ;
    gov:status "Provisional"@en .

gov:TrustMember
    a skos:Concept ; skos:inScheme gov:governanceTaxonomy ;
    skos:prefLabel "Trust member"@en ;
    skos:broader gov:GovernanceParticipantType, gov:DelegatedGovernanceAppointment ;
    gov:status "Provisional"@en .

gov:CompanyDirector
    a skos:Concept ; skos:inScheme gov:governanceTaxonomy ;
    skos:prefLabel "Company director"@en ;
    skos:broader gov:GovernanceParticipantType ;
    skos:related gov:Trustee, gov:AcademyTrustee ;
    gov:status "Provisional"@en .

gov:Director
    a skos:Concept ; skos:inScheme gov:governanceTaxonomy ;
    skos:prefLabel "Director"@en ;
    skos:broader gov:GovernanceParticipantType ;
    skos:related gov:Trustee, gov:AcademyTrustee ;
    gov:status "Provisional"@en .

gov:CharityTrustee
    a skos:Concept ; skos:inScheme gov:governanceTaxonomy ;
    skos:prefLabel "Charity trustee"@en ;
    skos:broader gov:GovernanceParticipantType ;
    skos:related gov:Trustee, gov:AcademyTrustee ;
    gov:status "Provisional"@en .

gov:Clerk
    a skos:Concept ; skos:inScheme gov:governanceTaxonomy ;
    skos:prefLabel "Clerk"@en ;
    skos:broader gov:GovernanceParticipantType, gov:ProfessionalSupportRole ;
    gov:status "Provisional"@en .

gov:GovernanceProfessional
    a skos:Concept ; skos:inScheme gov:governanceTaxonomy ;
    skos:prefLabel "Governance professional"@en ;
    skos:broader gov:GovernanceParticipantType, gov:ProfessionalSupportRole ;
    gov:status "Provisional"@en .

gov:Principal
    a skos:Concept ; skos:inScheme gov:governanceTaxonomy ;
    skos:prefLabel "Principal"@en ;
    skos:broader gov:GovernanceParticipantType, gov:OperationalEmploymentRole ;
    gov:status "Provisional"@en .

gov:Appointment
    a skos:Concept ; skos:inScheme gov:governanceTaxonomy ;
    skos:prefLabel "Appointment"@en ;
    skos:broader gov:AppointmentType, gov:AppointmentAndTermStatus ;
    gov:status "Provisional"@en .

gov:Membership
    a skos:Concept ; skos:inScheme gov:governanceTaxonomy ;
    skos:prefLabel "Membership"@en ;
    skos:broader gov:AppointmentType ;
    gov:status "Provisional"@en .

gov:BoardMembership
    a skos:Concept ; skos:inScheme gov:governanceTaxonomy ;
    skos:prefLabel "Board membership"@en ;
    skos:broader gov:AppointmentType ;
    gov:status "Provisional"@en .

gov:CommitteeMembership
    a skos:Concept ; skos:inScheme gov:governanceTaxonomy ;
    skos:prefLabel "Committee membership"@en ;
    skos:broader gov:AppointmentType, gov:CommitteeResponsibility ;
    gov:status "Provisional"@en .

gov:RoleAssignment
    a skos:Concept ; skos:inScheme gov:governanceTaxonomy ;
    skos:prefLabel "Role assignment"@en ;
    skos:broader gov:AppointmentType ;
    gov:status "Provisional"@en .

gov:AppointingBody
    a skos:Concept ; skos:inScheme gov:governanceTaxonomy ;
    skos:prefLabel "Appointing body"@en ;
    skos:broader gov:AppointingBodyType ;
    gov:status "Provisional"@en .

gov:Role
    a skos:Concept ; skos:inScheme gov:governanceTaxonomy ;
    skos:prefLabel "Role"@en ;
    skos:broader gov:RoleAndOfficeResponsibility ;
    gov:status "Provisional"@en .

gov:OfficeHolder
    a skos:Concept ; skos:inScheme gov:governanceTaxonomy ;
    skos:prefLabel "Office-holder"@en ;
    skos:broader gov:RoleAndOfficeResponsibility ;
    gov:status "Provisional"@en .

gov:Chair
    a skos:Concept ; skos:inScheme gov:governanceTaxonomy ;
    skos:prefLabel "Chair"@en ;
    skos:broader gov:RoleAndOfficeResponsibility, gov:StatutoryGovernanceAppointment ;
    gov:status "Provisional"@en .

gov:ViceChair
    a skos:Concept ; skos:inScheme gov:governanceTaxonomy ;
    skos:prefLabel "Vice chair"@en ;
    skos:broader gov:RoleAndOfficeResponsibility, gov:StatutoryGovernanceAppointment ;
    gov:status "Provisional"@en .

gov:CommitteeChair
    a skos:Concept ; skos:inScheme gov:governanceTaxonomy ;
    skos:prefLabel "Committee chair"@en ;
    skos:broader gov:RoleAndOfficeResponsibility, gov:CommitteeResponsibility, gov:StatutoryGovernanceAppointment ;
    gov:status "Provisional"@en .

gov:CommitteeViceChair
    a skos:Concept ; skos:inScheme gov:governanceTaxonomy ;
    skos:prefLabel "Committee vice chair"@en ;
    skos:broader gov:RoleAndOfficeResponsibility, gov:CommitteeResponsibility, gov:StatutoryGovernanceAppointment ;
    gov:status "Provisional"@en .

gov:SpecialistResponsibility
    a skos:Concept ; skos:inScheme gov:governanceTaxonomy ;
    skos:prefLabel "Specialist responsibility"@en ;
    skos:definition "A named subject or portfolio responsibility (e.g. Curriculum, Sustainability, Safeguarding, SEND) a governor or trustee holds, distinct from Chair, Vice Chair and Committee Chair. One generic value covering an open-ended, school- or trust-invented set of labels, rather than a named individual per topic - the specific topic is recorded on the individual appointment, not in this taxonomy."@en ;
    skos:broader gov:RoleAndOfficeResponsibility ;
    gov:status "Provisional"@en .

gov:AccountingOfficer
    a skos:Concept ; skos:inScheme gov:governanceTaxonomy ;
    skos:prefLabel "Accounting officer"@en ;
    skos:broader gov:RoleAndOfficeResponsibility, gov:OperationalEmploymentRole ;
    gov:status "Provisional"@en .

gov:ChiefFinancialOfficer
    a skos:Concept ; skos:inScheme gov:governanceTaxonomy ;
    skos:prefLabel "Chief financial officer"@en ;
    skos:broader gov:RoleAndOfficeResponsibility, gov:OperationalEmploymentRole ;
    gov:status "Provisional"@en .

gov:CompanySecretary
    a skos:Concept ; skos:inScheme gov:governanceTaxonomy ;
    skos:prefLabel "Company secretary"@en ;
    skos:broader gov:RoleAndOfficeResponsibility, gov:ProfessionalSupportRole ;
    gov:status "Provisional"@en .

gov:Committee
    a skos:Concept ; skos:inScheme gov:governanceTaxonomy ;
    skos:prefLabel "Committee"@en ;
    skos:broader gov:CommitteeResponsibility ;
    gov:status "Provisional"@en .

gov:Constitution
    a skos:Concept ; skos:inScheme gov:governanceTaxonomy ;
    skos:prefLabel "Constitution"@en ;
    skos:broader gov:ConstitutionPositionType ;
    gov:status "Provisional"@en .

