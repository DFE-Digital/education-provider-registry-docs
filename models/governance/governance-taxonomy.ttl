gov:MaintainedSchoolGoverningBodyType
    a skos:Concept ; skos:inScheme gov:governanceTaxonomy ;
    skos:prefLabel "Maintained school governing body"@en ;
    skos:definition "A governing body constituted to govern a maintained school."@en ;
    skos:broader gov:GovernanceBodyType ;
    rdfs:isDefinedBy <https://www.gov.uk/government/publications/maintained-schools-governance-guide/maintained-schools-governance-guide> ;
    gov:evidenceStatus "Documented fact"@en ; gov:valueControl "Fixed"@en ; gov:status "Provisional"@en .

gov:FederationGoverningBodyType
    a skos:Concept ; skos:inScheme gov:governanceTaxonomy ;
    skos:prefLabel "Federation governing body"@en ;
    skos:definition "A single governing body shared by two or more maintained schools in a statutory federation."@en ;
    skos:broader gov:GovernanceBodyType ;
    rdfs:isDefinedBy <https://www.gov.uk/government/publications/governance-in-federations> ;
    gov:evidenceStatus "Documented fact"@en ; gov:valueControl "Fixed"@en ; gov:status "Provisional"@en .

gov:TrustBoardGovernanceBodyType
    a skos:Concept ; skos:inScheme gov:governanceTaxonomy ;
    skos:prefLabel "Trust board"@en ;
    skos:definition "The accountable governance body of an academy trust."@en ;
    skos:broader gov:GovernanceBodyType ;
    rdfs:isDefinedBy <https://help.governorhub.com/en/articles/586814-the-trust-board>,
        <https://www.gov.uk/government/publications/academy-trust-handbook/academy-trust-handbook-2025-effective-from-1-september-2025> ;
    gov:evidenceStatus "Documented fact"@en ; gov:valueControl "Configurable label"@en ; gov:status "Provisional"@en .

gov:LocalGoverningBodyType
    a skos:Concept ; skos:inScheme gov:governanceTaxonomy ;
    skos:prefLabel "Local governing body"@en ;
    skos:definition "A delegated local governance body established by an academy trust."@en ;
    skos:broader gov:GovernanceBodyType ;
    rdfs:isDefinedBy <https://help.governorhub.com/en/articles/586814-the-trust-board> ;
    gov:evidenceStatus "Documented fact"@en ; gov:valueControl "Configurable label"@en ; gov:status "Provisional"@en .

gov:CommitteeGovernanceBodyType
    a skos:Concept ; skos:inScheme gov:governanceTaxonomy ;
    skos:prefLabel "Governance committee"@en ;
    skos:definition "A committee established to undertake governance work or delegated responsibilities."@en ;
    skos:broader gov:GovernanceBodyType ;
