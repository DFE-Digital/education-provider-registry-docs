    skos:topConceptOf gov:governanceTaxonomy ;
    skos:prefLabel "Appointing party type"@en ;
    skos:altLabel "Appointing body type"@en ;
    skos:definition "The classification of the party that appoints or nominates a person to a governance appointment."@en ;
    skos:scopeNote "GovernorHub documents an Appointed by field but does not publish its complete value set. These values are grounded in real-world governance rules; their mapping to GovernorHub remains unresolved."@en ;
    skos:narrower
        gov:LocalAuthorityAppointingParty,
        gov:GoverningBodyAppointingParty,
        gov:FoundationBodyAppointingParty,
        gov:AcademyTrustMembersAppointingParty ;
    gov:status "Provisional"@en .

gov:GovernanceRoleType
    a skos:Concept ;
    skos:inScheme gov:governanceTaxonomy ;
    skos:topConceptOf gov:governanceTaxonomy ;
    skos:prefLabel "Governance role type"@en ;
    skos:definition "A named office or responsibility assigned independently from a person's governance appointment type."@en ;
    skos:scopeNote "Principal and other employment positions are not treated as governance roles solely because their holders attend or support governance."@en ;
    skos:narrower
        gov:ChairRole,
        gov:ViceChairRole,
        gov:ClerkRole,
        gov:GovernanceProfessionalRole,
        gov:AccountingOfficerRole ;
    gov:status "Provisional"@en .

gov:CommitteeRoleType
    a skos:Concept ;
    skos:inScheme gov:governanceTaxonomy ;
    skos:topConceptOf gov:governanceTaxonomy ;
    skos:prefLabel "Committee role type"@en ;
    skos:definition "A named office or responsibility held within the scope of a governance committee."@en ;
    skos:scopeNote "Committee membership is a relationship, not a role value. Committee Admin is a product permission and is outside this business taxonomy."@en ;
    skos:narrower
        gov:CommitteeChairRole,
        gov:CommitteeViceChairRole ;
    gov:status "Provisional"@en .

gov:ConstitutionPositionCategory
    a skos:Concept ;
    skos:inScheme gov:governanceTaxonomy ;
    skos:topConceptOf gov:governanceTaxonomy ;
    skos:prefLabel "Constitution position category"@en ;
    skos:definition "The category of a position required or permitted by a governance body's constitution."@en ;
    skos:scopeNote "A Constitution position category and an appointment type may have similar labels, but they classify different things."@en ;
    skos:narrower
        gov:ParentGovernorConstitutionPositionCategory,
        gov:StaffGovernorConstitutionPositionCategory,
        gov:CoOptedGovernorConstitutionPositionCategory,
        gov:FoundationGovernorConstitutionPositionCategory,
        gov:LocalAuthorityGovernorConstitutionPositionCategory,
        gov:ExOfficioGovernorConstitutionPositionCategory ;
    gov:status "Provisional"@en .

gov:ConstitutionPositionOccupancy
    a skos:Concept ;
    skos:inScheme gov:governanceTaxonomy ;
    skos:topConceptOf gov:governanceTaxonomy ;
    skos:prefLabel "Constitution position occupancy"@en ;
    skos:definition "Whether a Constitution position is currently filled by a qualifying appointment."@en ;
    skos:scopeNote "Vacancy is derived from a Constitution position not being filled; it is not a property of a person."@en ;
    skos:narrower
        gov:FilledConstitutionPosition,
        gov:VacantConstitutionPosition ;
    gov:status "Provisional"@en .

gov:MembershipStatus
    a skos:Concept ;
    skos:inScheme gov:governanceTaxonomy ;
    skos:topConceptOf gov:governanceTaxonomy ;
    skos:prefLabel "Membership status"@en ;
    skos:definition "The lifecycle classification of a person's membership of a governance body."@en ;
    skos:narrower
        gov:CurrentMembershipStatus,
        gov:EndedMembershipStatus ;
    gov:status "Provisional"@en .

gov:AppointmentStatus
    a skos:Concept ;
    skos:inScheme gov:governanceTaxonomy ;
    skos:topConceptOf gov:governanceTaxonomy ;
    skos:prefLabel "Appointment status"@en ;
    skos:definition "The lifecycle classification of a governance appointment."@en ;
    skos:scopeNote "Renewal is a business action, not a status. Public evidence does not establish a formal GovernorHub stored state set."@en ;
    skos:narrower
        gov:CurrentAppointmentStatus,
        gov:PreviousAppointmentStatus,
        gov:EndedAppointmentStatus ;
    gov:status "Provisional"@en .

gov:TermStatus
    a skos:Concept ;
    skos:inScheme gov:governanceTaxonomy ;
    skos:topConceptOf gov:governanceTaxonomy ;
    skos:prefLabel "Term status"@en ;
    skos:definition "The lifecycle classification of a term of office."@en ;
    skos:scopeNote "Term statuses are date-derived candidate classifications rather than confirmed GovernorHub stored values."@en ;
    skos:narrower
        gov:FutureTermStatus,
        gov:CurrentTermStatus,
        gov:ExpiredTermStatus,
        gov:EndedEarlyTermStatus ;
    gov:status "Provisional"@en .

gov:HistoricalRecordProvenance
    a skos:Concept ;
    skos:inScheme gov:governanceTaxonomy ;
    skos:topConceptOf gov:governanceTaxonomy ;
    skos:prefLabel "Historical record provenance"@en ;
    skos:definition "The origin or subsequent correction provenance of a retained historical governance representation."@en ;
    skos:scopeNote "Historical Member and Historical Appointment are views of ended relationships, not types of person or appointment."@en ;
    skos:narrower
        gov:AutomaticallyCreatedHistoricalRecord,
        gov:ManuallyCreatedHistoricalRecord,
        gov:BackfilledHistoricalRecord,
        gov:CorrectedHistoricalRecord ;
    gov:status "Provisional"@en .

gov:DeclarationOutcome
    a skos:Concept ;
    skos:inScheme gov:governanceTaxonomy ;
    skos:topConceptOf gov:governanceTaxonomy ;
    skos:prefLabel "Declaration outcome"@en ;
    skos:definition "The substantive outcome recorded for a declaration of interests."@en ;
    skos:narrower
        gov:InterestDeclaredOutcome,
        gov:NothingToDeclareOutcome ;
    gov:status "Provisional"@en .

gov:ConfirmationStatus
    a skos:Concept ;
    skos:inScheme gov:governanceTaxonomy ;
    skos:topConceptOf gov:governanceTaxonomy ;
    skos:prefLabel "Confirmation status"@en ;
    skos:definition "The validity or reversal state of a declaration or assurance confirmation."@en ;
    skos:scopeNote "These values must not be reused as appointment, membership or training statuses."@en ;
    skos:narrower
        gov:ConfirmedConfirmationStatus,
        gov:ExpiredConfirmationStatus,
        gov:NotConfirmedConfirmationStatus,
        gov:UnconfirmedConfirmationStatus ;
    gov:status "Provisional"@en .

gov:AssuranceRecordType
    a skos:Concept ;
    skos:inScheme gov:governanceTaxonomy ;
    skos:topConceptOf gov:governanceTaxonomy ;
    skos:prefLabel "Assurance record type"@en ;
    skos:definition "The classification of evidence or activity records used to support governance assurance."@en ;
    skos:scopeNote "The values remain distinct because their subjects, lifecycles, evidence and sensitivity differ."@en ;
    skos:narrower
        gov:DeclarationOfInterestRecordType,
        gov:ConfirmationRecordType,
        gov:TrainingRecordType,
        gov:TrainingBookingRecordType,
        gov:TrainingAttendanceRecordType,
        gov:TrainingCertificateRecordType,
        gov:DbsCheckRecordType ;
    gov:status "Provisional"@en .

