gov:GovernanceAppointmentType
    a skos:Concept ;
    skos:inScheme gov:governanceTaxonomy ;
    skos:topConceptOf gov:governanceTaxonomy ;
    skos:prefLabel "Governance appointment type"@en ;
    skos:altLabel "Governor type"@en ;
    skos:definition "The category or route through which a person holds a governance appointment."@en ;
    skos:scopeNote "This facet classifies an appointment. It does not identify the appointing party, an office such as Chair, or a Constitution position."@en ;
    skos:narrower
        gov:ParentGovernorAppointmentType,
        gov:StaffGovernorAppointmentType,
        gov:CoOptedGovernorAppointmentType,
        gov:FoundationGovernorAppointmentType,
        gov:LocalAuthorityGovernorAppointmentType,
        gov:ExOfficioGovernorAppointmentType ;
    gov:status "Provisional"@en .

