gov:InterimExecutiveBoardType
    a skos:Concept ; skos:inScheme gov:governanceTaxonomy ;
    skos:prefLabel "Interim Executive Board"@en ;
    skos:definition "A temporary governing body established under statutory intervention powers."@en ;
    skos:broader gov:GovernanceBodyType ;
    rdfs:isDefinedBy <https://www.legislation.gov.uk/ukpga/2006/40/section/65> ;
    gov:evidenceStatus "Documented fact"@en ; gov:valueControl "Fixed"@en ; gov:status "Provisional"@en .

#################################################################
# Governance participant capacity
#################################################################

gov:GovernorCapacity
    a skos:Concept ; skos:inScheme gov:governanceTaxonomy ;
    skos:prefLabel "Governor"@en ;
    skos:definition "The capacity of participating in the governance of a school through its governing body."@en ;
    skos:broader gov:GovernanceParticipantCapacity ;
    rdfs:isDefinedBy <https://help.governorhub.com/en/articles/586879-the-governing-board-membership> ;
    gov:evidenceStatus "Documented fact"@en ; gov:valueControl "Fixed"@en ; gov:status "Provisional"@en .

gov:LocalGovernorCapacity
    a skos:Concept ; skos:inScheme gov:governanceTaxonomy ;
    skos:prefLabel "Local governor"@en ;
    skos:definition "The capacity of participating in governance through a local governing body established by an academy trust."@en ;
    skos:broader gov:GovernanceParticipantCapacity ;
    rdfs:isDefinedBy <https://www.gov.uk/government/publications/academy-trust-handbook/academy-trust-handbook-2025-effective-from-1-september-2025> ;
    gov:evidenceStatus "Documented fact"@en ; gov:valueControl "Trust-defined"@en ; gov:status "Provisional"@en .

gov:AcademyTrustMemberCapacity
    a skos:Concept ; skos:inScheme gov:governanceTaxonomy ;
    skos:prefLabel "Academy trust member"@en ;
    skos:definition "The constitutional company-member capacity held in an academy trust."@en ;
    skos:broader gov:GovernanceParticipantCapacity ;
    rdfs:isDefinedBy <https://www.gov.uk/government/publications/academy-trust-handbook/academy-trust-handbook-2025-effective-from-1-september-2025> ;
    gov:evidenceStatus "Documented real-world fact; GovernorHub mapping unresolved"@en ; gov:valueControl "Unknown"@en ; gov:status "Provisional"@en .

gov:AcademyTrusteeCapacity
    a skos:Concept ; skos:inScheme gov:governanceTaxonomy ;
    skos:prefLabel "Academy trustee"@en ;
    skos:definition "The charity-trustee capacity held by a member of an academy trust's trust board."@en ;
    skos:broader gov:GovernanceParticipantCapacity ;
    rdfs:isDefinedBy <https://www.gov.uk/government/publications/academy-trust-handbook/academy-trust-handbook-2025-effective-from-1-september-2025> ;
    gov:evidenceStatus "Documented fact"@en ; gov:valueControl "Fixed"@en ; gov:status "Provisional"@en .

gov:CompanyDirectorCapacity
    a skos:Concept ; skos:inScheme gov:governanceTaxonomy ;
    skos:prefLabel "Company director"@en ;
    skos:definition "The company-law director capacity held by an academy trustee."@en ;
    skos:broader gov:GovernanceParticipantCapacity ;
    rdfs:isDefinedBy <https://www.legislation.gov.uk/ukpga/2006/46/section/250>,
        <https://www.gov.uk/government/publications/academy-trust-handbook/academy-trust-handbook-2025-effective-from-1-september-2025> ;
    gov:evidenceStatus "Documented real-world fact; GovernorHub equivalence unresolved"@en ; gov:valueControl "Fixed"@en ; gov:status "Provisional"@en .

gov:ClerkCapacity
    a skos:Concept ; skos:inScheme gov:governanceTaxonomy ;
    skos:prefLabel "Clerk capacity"@en ;
    skos:definition "The capacity of providing procedural and administrative support to a governance body."@en ;
    skos:broader gov:GovernanceParticipantCapacity ;
    rdfs:isDefinedBy <https://help.governorhub.com/en/articles/1657553-assigning-or-creating-a-role> ;
    gov:evidenceStatus "Documented fact"@en ; gov:valueControl "Fixed"@en ; gov:status "Provisional"@en .

gov:GovernanceProfessionalCapacity
    a skos:Concept ; skos:inScheme gov:governanceTaxonomy ;
    skos:prefLabel "Governance professional capacity"@en ;
    skos:definition "The professional capacity of supporting effective governance administration and procedure."@en ;
    skos:broader gov:GovernanceParticipantCapacity ;
    rdfs:isDefinedBy <https://www.gov.uk/government/publications/maintained-schools-governance-guide/maintained-schools-governance-guide> ;
    gov:evidenceStatus "Documented real-world fact; GovernorHub value control unresolved"@en ; gov:valueControl "Unknown"@en ; gov:status "Provisional"@en .

#################################################################
# Governance appointment type
#################################################################

gov:ParentGovernorAppointmentType
    a skos:Concept ; skos:inScheme gov:governanceTaxonomy ;
    skos:prefLabel "Parent governor"@en ;
    skos:definition "An appointment type for a governor elected or appointed through the parent category."@en ;
    skos:broader gov:GovernanceAppointmentType ; skos:related gov:ParentGovernor ;
    rdfs:isDefinedBy <https://help.governorhub.com/en/articles/586879-the-governing-board-membership> ;
    gov:evidenceStatus "Documented GovernorHub example"@en ; gov:valueControl "Fixed"@en ; gov:status "Provisional"@en .

gov:StaffGovernorAppointmentType
    a skos:Concept ; skos:inScheme gov:governanceTaxonomy ;
    skos:prefLabel "Staff governor"@en ;
    skos:definition "An appointment type for a governor serving through the staff category."@en ;
    skos:broader gov:GovernanceAppointmentType ; skos:related gov:StaffGovernor ;
    rdfs:isDefinedBy <https://help.governorhub.com/en/articles/586879-the-governing-board-membership> ;
    gov:evidenceStatus "Documented GovernorHub example"@en ; gov:valueControl "Fixed"@en ; gov:status "Provisional"@en .

gov:CoOptedGovernorAppointmentType
    a skos:Concept ; skos:inScheme gov:governanceTaxonomy ;
    skos:prefLabel "Co-opted governor"@en ;
