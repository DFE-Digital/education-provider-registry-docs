@prefix gov: <https://dfe-digital.github.io/education-provider-registry-docs/models/governance/vocabulary/> .
@prefix epr: <https://dfe-digital.github.io/education-provider-registry-docs/vocabulary/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Governance vocabulary
#
# Scope: a flat, provisional vocabulary of nouns in the governance subdomain.
# This file intentionally does not assert skos:broader, skos:narrower or
# taxonomy facets. Definitions are working business definitions and require
# domain review before promotion to a canonical EPR vocabulary.
#
# Establishment/organisation-scope nouns that already belong to the main
# Education Provider Registry vocabulary (Academy, AcademyTrust,
# Establishment, Federation, LocalAuthority, Person) are not duplicated
# here. They are referenced directly as epr: URIs in governance-taxonomy.ttl
# and governance-ontology.ttl where a governance-specific classification or
# property needs to attach to them.

gov:status
    a rdf:Property ;
    rdfs:label "Vocabulary status"@en ;
    rdfs:comment "The review status assigned to a governance vocabulary concept."@en .

gov:legislation
    a rdf:Property ;
    rdfs:label "Legislation"@en ;
    rdfs:comment "The Act of Parliament or Statutory Instrument that creates or defines this concept in English law. Value is a legislation.gov.uk URI."@en .

gov:governanceVocabulary
    a skos:ConceptScheme ;
    dcterms:title "Governance Vocabulary"@en ;
    dcterms:description "Flat provisional vocabulary of nouns in the governance subdomain."@en ;
    dcterms:created "2026-07-27"^^xsd:date ;
    gov:status "Provisional"@en .

gov:governanceConcepts
    a skos:Collection ;
    skos:inScheme gov:governanceVocabulary ;
    skos:prefLabel "Governance concepts"@en ;
    skos:member
        gov:AcademyTrustMember,
        gov:AcademyTrustee,
        gov:AccountingOfficer,
        gov:Appointment,
        gov:AppointingBody,
        gov:AssociateGovernor,
        gov:Attendance,
        gov:Board,
        gov:BoardMember,
        gov:BoardMembership,
        gov:BoardOfDirectors,
        gov:Chair,
        gov:ChangeHistory,
        gov:ChiefFinancialOfficer,
        gov:Clerk,
        gov:CompanyDirector,
        gov:CompanySecretary,
        gov:Committee,
        gov:CommitteeChair,
        gov:CommitteeMembership,
        gov:CompaniesHouseLegalEntity,
        gov:Confirmation,
        gov:Constitution,
        gov:ConstitutionPosition,
        gov:CoOptedGovernor,
        gov:Declaration,
        gov:DeclarationOfInterest,
        gov:Director,
        gov:ExOfficioGovernor,
        gov:FoundationGovernor,
        gov:GoverningBoard,
        gov:GoverningBody,
        gov:Governor,
        gov:GovernorType,
        gov:Governance,
        gov:GovernanceProfessional,
        gov:HistoricalAppointment,
        gov:HistoricalMember,
        gov:HistoricalRecord,
        gov:InterimExecutiveBoard,
        gov:LocalAuthorityGovernor,
        gov:LocalGoverningBody,
        gov:LocalGovernor,
        gov:LocalGoverningBodyMember,
        gov:Meeting,
        gov:Member,
        gov:Membership,
        gov:Noticeboard,
        gov:OfficeHolder,
        gov:ParentGovernor,
        gov:PartnershipGovernor,
        gov:Principal,
        gov:Role,
        gov:RoleAssignment,
        gov:School,
        gov:StaffGovernor,
        gov:TermOfOffice,
        gov:Training,
        gov:TrainingRecord,
        gov:Trustee,
        gov:TrustBoard,
        gov:TrustMember,
        gov:Vacancy,
        gov:ViceChair .

# Flat concepts

gov:AcademyTrustMember a skos:Concept ; skos:inScheme gov:governanceVocabulary ; skos:prefLabel "Academy trust member"@en ; skos:definition "A person or body holding membership of an academy trust as a company member."@en ; gov:status "Provisional"@en ; rdfs:isDefinedBy <https://www.gov.uk/government/publications/academy-trust-handbook/academy-trust-handbook-2025-effective-from-1-september-2025> ; gov:legislation <https://www.legislation.gov.uk/ukpga/2006/46/section/112> ; rdfs:seeAlso <https://dfe-digital.github.io/education-provider-registry-docs/models/governance/vocabulary/references/#academy-trust-member> .
gov:AcademyTrustee a skos:Concept ; skos:inScheme gov:governanceVocabulary ; skos:prefLabel "Academy trustee"@en ; skos:definition "A person serving as a trustee and director of an academy trust."@en ; gov:status "Provisional"@en ; rdfs:isDefinedBy <https://www.gov.uk/government/publications/academy-trust-handbook/academy-trust-handbook-2025-effective-from-1-september-2025> ; gov:legislation <https://www.legislation.gov.uk/ukpga/2006/46/section/250>, <https://www.legislation.gov.uk/ukpga/2011/25/section/177> ; rdfs:seeAlso <https://dfe-digital.github.io/education-provider-registry-docs/models/governance/vocabulary/references/#academy-trustee> .
gov:AccountingOfficer a skos:Concept ; skos:inScheme gov:governanceVocabulary ; skos:prefLabel "Accounting officer"@en ; skos:definition "The person accountable for the proper use, control and stewardship of an academy trust's resources."@en ; gov:status "Provisional"@en ; rdfs:isDefinedBy <https://www.gov.uk/government/publications/academy-trust-handbook/academy-trust-handbook-2025-effective-from-1-september-2025> ; rdfs:seeAlso <https://dfe-digital.github.io/education-provider-registry-docs/models/governance/vocabulary/references/#accounting-officer> .
gov:Appointment a skos:Concept ; skos:inScheme gov:governanceVocabulary ; skos:prefLabel "Appointment"@en ; skos:definition "The act or resulting arrangement by which a person takes a governance position or role."@en ; gov:status "Provisional"@en ; rdfs:isDefinedBy <https://www.gov.uk/government/publications/maintained-schools-governance-guide/maintained-schools-governance-guide> ; gov:legislation <https://www.legislation.gov.uk/uksi/2012/1034/regulation/16/made> ; rdfs:seeAlso <https://dfe-digital.github.io/education-provider-registry-docs/models/governance/vocabulary/references/#appointment> .
gov:AppointingBody a skos:Concept ; skos:inScheme gov:governanceVocabulary ; skos:prefLabel "Appointing body"@en ; skos:definition "The body or mechanism that appoints or elects a governance role-holder."@en ; gov:status "Provisional"@en ; gov:legislation <https://www.legislation.gov.uk/uksi/2012/1034/regulation/8/made>, <https://www.legislation.gov.uk/uksi/2012/1034/regulation/16/made> ; rdfs:seeAlso <https://dfe-digital.github.io/education-provider-registry-docs/models/governance/vocabulary/references/#appointing-body> .
gov:AssociateGovernor a skos:Concept ; skos:inScheme gov:governanceVocabulary ; skos:prefLabel "Associate governor"@en ; skos:altLabel "Associate member"@en ; skos:definition "A person appointed by a governing body as a member of a committee, to bring specific skills or experience, who is not thereby a governor and is not a member of the governing body itself. May be given a vote on committee business by the governing body, but never at the governing body itself, and never at all unless aged over 18."@en ; gov:status "Provisional"@en ; gov:legislation <https://www.legislation.gov.uk/uksi/2012/1034/regulation/12/made>, <https://www.legislation.gov.uk/uksi/2013/1624/regulation/24/made> ; rdfs:seeAlso <https://dfe-digital.github.io/education-provider-registry-docs/models/governance/vocabulary/references/#associate-governor> .
gov:Attendance a skos:Concept ; skos:inScheme gov:governanceVocabulary ; skos:prefLabel "Attendance"@en ; skos:definition "A record of a person's participation at a governance meeting or activity."@en ; gov:status "Provisional"@en ; rdfs:isDefinedBy <https://www.gov.uk/government/publications/maintained-schools-governance-guide/maintained-schools-governance-guide> ; gov:legislation <https://www.legislation.gov.uk/uksi/2012/1034/schedule/4/made> ; rdfs:seeAlso <https://dfe-digital.github.io/education-provider-registry-docs/models/governance/vocabulary/references/#attendance> .
gov:Board a skos:Concept ; skos:inScheme gov:governanceVocabulary ; skos:prefLabel "Board"@en ; skos:definition "A body of people responsible for collective governance or oversight."@en ; gov:status "Provisional"@en ; rdfs:isDefinedBy <https://www.gov.uk/government/publications/academy-trust-handbook/academy-trust-handbook-2025-effective-from-1-september-2025>, <https://www.gov.uk/government/publications/academy-trust-governance-guide> ; rdfs:seeAlso <https://dfe-digital.github.io/education-provider-registry-docs/models/governance/vocabulary/references/#board> .
gov:BoardMember a skos:Concept ; skos:inScheme gov:governanceVocabulary ; skos:prefLabel "Board member"@en ; skos:definition "A person who is a member of a governance board."@en ; gov:status "Provisional"@en ; rdfs:isDefinedBy <https://www.gov.uk/government/publications/academy-trust-handbook/academy-trust-handbook-2025-effective-from-1-september-2025> ; rdfs:seeAlso <https://dfe-digital.github.io/education-provider-registry-docs/models/governance/vocabulary/references/#board-member> .
gov:BoardMembership a skos:Concept ; skos:inScheme gov:governanceVocabulary ; skos:prefLabel "Board membership"@en ; skos:definition "The relationship between a person and a governance board."@en ; gov:status "Provisional"@en ; rdfs:isDefinedBy <https://www.gov.uk/government/publications/academy-trust-handbook/academy-trust-handbook-2025-effective-from-1-september-2025> ; rdfs:seeAlso <https://dfe-digital.github.io/education-provider-registry-docs/models/governance/vocabulary/references/#board-membership> .
gov:BoardOfDirectors a skos:Concept ; skos:inScheme gov:governanceVocabulary ; skos:prefLabel "Board of directors"@en ; skos:definition "The directors acting collectively as the governing board of a company or trust."@en ; gov:status "Provisional"@en ; rdfs:isDefinedBy <https://www.gov.uk/government/publications/academy-trust-handbook/academy-trust-handbook-2025-effective-from-1-september-2025> ; gov:legislation <https://www.legislation.gov.uk/ukpga/2006/46/section/154> ; rdfs:seeAlso <https://dfe-digital.github.io/education-provider-registry-docs/models/governance/vocabulary/references/#board-of-directors> .
gov:Chair a skos:Concept ; skos:inScheme gov:governanceVocabulary ; skos:prefLabel "Chair"@en ; skos:definition "The office-holder who chairs a governance board, body or committee."@en ; gov:status "Provisional"@en ; rdfs:isDefinedBy <https://www.gov.uk/government/publications/academy-trust-handbook/academy-trust-handbook-2025-effective-from-1-september-2025> ; gov:legislation <https://www.legislation.gov.uk/uksi/2013/1624/regulation/7/made> ; rdfs:seeAlso <https://dfe-digital.github.io/education-provider-registry-docs/models/governance/vocabulary/references/#chair> .
gov:ChangeHistory a skos:Concept ; skos:inScheme gov:governanceVocabulary ; skos:prefLabel "Change history"@en ; skos:definition "A record of changes to a governance person, membership, appointment, role or related record."@en ; gov:status "Provisional"@en ; rdfs:isDefinedBy <https://www.gov.uk/government/publications/academy-trust-handbook/academy-trust-handbook-2025-effective-from-1-september-2025> ; rdfs:seeAlso <https://dfe-digital.github.io/education-provider-registry-docs/models/governance/vocabulary/references/#change-history> .
gov:ChiefFinancialOfficer a skos:Concept ; skos:inScheme gov:governanceVocabulary ; skos:prefLabel "Chief financial officer"@en ; skos:altLabel "CFO"@en ; skos:definition "The academy trust's senior operational leader for finance, appointed by the board and responsible for the trust's detailed financial procedures. Typically a paid employee, distinct from Accounting Officer and not automatically a Trustee, Company Director or Academy Trust Member."@en ; gov:status "Provisional"@en ; rdfs:isDefinedBy <https://www.gov.uk/government/publications/academy-trust-handbook/academy-trust-handbook-2025-effective-from-1-september-2025> ; rdfs:seeAlso <https://dfe-digital.github.io/education-provider-registry-docs/models/governance/vocabulary/references/#chief-financial-officer> .
gov:Clerk a skos:Concept ; skos:inScheme gov:governanceVocabulary ; skos:prefLabel "Clerk"@en ; skos:definition "A person providing administrative and procedural support to a governing body or board."@en ; gov:status "Provisional"@en ; gov:legislation <https://www.legislation.gov.uk/uksi/2013/1624/regulation/11/made> ; rdfs:seeAlso <https://dfe-digital.github.io/education-provider-registry-docs/models/governance/vocabulary/references/#clerk> .
gov:CompanyDirector a skos:Concept ; skos:inScheme gov:governanceVocabulary ; skos:prefLabel "Company director"@en ; skos:definition "A person appointed to direct and manage a company under company law. For an academy trust, this is a legal capacity that a Trustee holds automatically alongside their charity trustee capacity, not a separate appointment - see Trustee, Academy trustee."@en ; gov:status "Provisional"@en ; rdfs:isDefinedBy <https://www.gov.uk/running-a-limited-company/becoming-a-company-director> ; gov:legislation <https://www.legislation.gov.uk/ukpga/2006/46/section/250> ; rdfs:seeAlso <https://dfe-digital.github.io/education-provider-registry-docs/models/governance/vocabulary/references/#company-director> .
gov:CompanySecretary a skos:Concept ; skos:inScheme gov:governanceVocabulary ; skos:prefLabel "Company secretary"@en ; skos:definition "A company office associated with the academy trust legal entity, providing governance and compliance support. Optional under company law; not automatically a Company Director or Academy Trustee; remains a distinct appointment even where held by the same person as Governance Professional."@en ; gov:status "Provisional"@en ; rdfs:isDefinedBy <https://cgi.org.uk/resources/guidance-notes/academy/the-role-and-duties-of-a-company-secretary-in-a-16-19-academy/> ; gov:legislation <https://www.legislation.gov.uk/ukpga/2006/46/section/270>, <https://www.legislation.gov.uk/ukpga/2006/46/section/1173> ; rdfs:seeAlso <https://dfe-digital.github.io/education-provider-registry-docs/models/governance/vocabulary/references/#company-secretary> .
gov:Committee a skos:Concept ; skos:inScheme gov:governanceVocabulary ; skos:prefLabel "Committee"@en ; skos:definition "A body established to undertake governance work or delegated responsibilities."@en ; gov:status "Provisional"@en ; gov:legislation <https://www.legislation.gov.uk/uksi/2013/1624/regulation/22/made> ; rdfs:seeAlso <https://dfe-digital.github.io/education-provider-registry-docs/models/governance/vocabulary/references/#committee> .
gov:CommitteeChair a skos:Concept ; skos:inScheme gov:governanceVocabulary ; skos:prefLabel "Committee chair"@en ; skos:definition "The office-holder who chairs a governance committee."@en ; gov:status "Provisional"@en ; gov:legislation <https://www.legislation.gov.uk/uksi/2013/1624/regulation/22/made> ; rdfs:seeAlso <https://dfe-digital.github.io/education-provider-registry-docs/models/governance/vocabulary/references/#committee-chair> .
gov:CommitteeMembership a skos:Concept ; skos:inScheme gov:governanceVocabulary ; skos:prefLabel "Committee membership"@en ; skos:definition "The relationship between a person and a governance committee."@en ; gov:status "Provisional"@en ; gov:legislation <https://www.legislation.gov.uk/uksi/2013/1624/regulation/22/made> ; rdfs:seeAlso <https://dfe-digital.github.io/education-provider-registry-docs/models/governance/vocabulary/references/#committee-membership> .
gov:CompaniesHouseLegalEntity a skos:Concept ; skos:inScheme gov:governanceVocabulary ; skos:prefLabel "Companies House legal entity"@en ; skos:definition "A legal entity registered with Companies House and relevant to a governance arrangement."@en ; gov:status "Provisional"@en ; rdfs:isDefinedBy <https://www.gov.uk/government/organisations/companies-house> ; gov:legislation <https://www.legislation.gov.uk/ukpga/2006/46/section/16> ; rdfs:seeAlso <https://dfe-digital.github.io/education-provider-registry-docs/models/governance/vocabulary/references/#companies-house-legal-entity> .
gov:Confirmation a skos:Concept ; skos:inScheme gov:governanceVocabulary ; skos:prefLabel "Confirmation"@en ; skos:definition "A formal confirmation of a governance person's details, appointment or required declaration."@en ; gov:status "Provisional"@en ; rdfs:isDefinedBy <https://www.gov.uk/government/publications/academy-trust-handbook/academy-trust-handbook-2025-effective-from-1-september-2025> ; gov:legislation <https://www.legislation.gov.uk/ukpga/2006/46/section/853A> ; rdfs:seeAlso <https://dfe-digital.github.io/education-provider-registry-docs/models/governance/vocabulary/references/#confirmation> .
gov:Constitution a skos:Concept ; skos:inScheme gov:governanceVocabulary ; skos:prefLabel "Constitution"@en ; skos:definition "The defined composition, responsibilities and arrangements of a governing body."@en ; gov:status "Provisional"@en ; gov:legislation <https://www.legislation.gov.uk/uksi/2012/1034/regulation/13/made> ; rdfs:seeAlso <https://dfe-digital.github.io/education-provider-registry-docs/models/governance/vocabulary/references/#constitution> .
gov:ConstitutionPosition a skos:Concept ; skos:inScheme gov:governanceVocabulary ; skos:prefLabel "Constitution position"@en ; skos:definition "A position provided for in the constitution of a governing body, whether occupied or vacant."@en ; gov:status "Provisional"@en ; gov:legislation <https://www.legislation.gov.uk/uksi/2012/1034/contents> ; rdfs:seeAlso <https://dfe-digital.github.io/education-provider-registry-docs/models/governance/vocabulary/references/#constitution-position> .
gov:CoOptedGovernor a skos:Concept ; skos:inScheme gov:governanceVocabulary ; skos:prefLabel "Co-opted governor"@en ; skos:definition "A governor appointed by a governing body through a co-option route."@en ; gov:status "Provisional"@en ; gov:legislation <https://www.legislation.gov.uk/uksi/2012/1034/regulation/11/made> ; rdfs:seeAlso <https://dfe-digital.github.io/education-provider-registry-docs/models/governance/vocabulary/references/#co-opted-governor> .
gov:Declaration a skos:Concept ; skos:inScheme gov:governanceVocabulary ; skos:prefLabel "Declaration"@en ; skos:definition "A formal statement made by a governance person or body."@en ; gov:status "Provisional"@en ; rdfs:isDefinedBy <https://www.gov.uk/government/publications/academy-trust-handbook/academy-trust-handbook-2025-effective-from-1-september-2025> ; rdfs:seeAlso <https://dfe-digital.github.io/education-provider-registry-docs/models/governance/vocabulary/references/#declaration> .
gov:DeclarationOfInterest a skos:Concept ; skos:inScheme gov:governanceVocabulary ; skos:prefLabel "Declaration of interest"@en ; skos:definition "A statement of an interest that may relate to a person's governance responsibilities."@en ; gov:status "Provisional"@en ; rdfs:isDefinedBy <https://www.gov.uk/government/publications/academy-trust-handbook/academy-trust-handbook-2025-effective-from-1-september-2025> ; rdfs:seeAlso <https://dfe-digital.github.io/education-provider-registry-docs/models/governance/vocabulary/references/#declaration-of-interest> .
gov:Director a skos:Concept ; skos:inScheme gov:governanceVocabulary ; skos:prefLabel "Director"@en ; skos:definition "A person holding a director office in a company or trust. In some academy trusts, such as church academies, this is the label used instead of Trustee for those on the board; it is the same underlying capacity, not a separate appointment - see Trustee, Academy trustee."@en ; gov:status "Provisional"@en ; rdfs:isDefinedBy <https://www.gov.uk/running-a-limited-company/becoming-a-company-director> ; gov:legislation <https://www.legislation.gov.uk/ukpga/2006/46/section/250> ; rdfs:seeAlso <https://dfe-digital.github.io/education-provider-registry-docs/models/governance/vocabulary/references/#director> .
gov:ExOfficioGovernor a skos:Concept ; skos:inScheme gov:governanceVocabulary ; skos:prefLabel "Ex-officio governor"@en ; skos:definition "A governor who holds membership by virtue of holding another specified office."@en ; gov:status "Provisional"@en ; gov:legislation <https://www.legislation.gov.uk/uksi/2012/1034/regulation/9/made> ; rdfs:seeAlso <https://dfe-digital.github.io/education-provider-registry-docs/models/governance/vocabulary/references/#ex-officio-governor> .
gov:FoundationGovernor a skos:Concept ; skos:inScheme gov:governanceVocabulary ; skos:prefLabel "Foundation governor"@en ; skos:definition "A governor appointed through a foundation or other foundation body route."@en ; gov:status "Provisional"@en ; gov:legislation <https://www.legislation.gov.uk/uksi/2012/1034/regulation/9/made> ; rdfs:seeAlso <https://dfe-digital.github.io/education-provider-registry-docs/models/governance/vocabulary/references/#foundation-governor> .
gov:GoverningBoard a skos:Concept ; skos:inScheme gov:governanceVocabulary ; skos:prefLabel "Governing board"@en ; skos:definition "The board responsible for the governance of an academy, school or other education establishment."@en ; gov:status "Provisional"@en ; rdfs:isDefinedBy <https://www.gov.uk/government/publications/academy-trust-handbook/academy-trust-handbook-2025-effective-from-1-september-2025> ; rdfs:seeAlso <https://dfe-digital.github.io/education-provider-registry-docs/models/governance/vocabulary/references/#governing-board> .
gov:GoverningBody a skos:Concept ; skos:inScheme gov:governanceVocabulary ; skos:prefLabel "Governing body"@en ; skos:definition "The body constituted to govern a maintained school or other education establishment."@en ; gov:status "Provisional"@en ; rdfs:isDefinedBy <https://www.gov.uk/government/publications/maintained-schools-governance-guide/maintained-schools-governance-guide> ; gov:legislation <https://www.legislation.gov.uk/ukpga/2002/32/section/19> ; rdfs:seeAlso <https://dfe-digital.github.io/education-provider-registry-docs/models/governance/vocabulary/references/#governing-body> .
gov:Governor a skos:Concept ; skos:inScheme gov:governanceVocabulary ; skos:prefLabel "Governor"@en ; skos:definition "A person appointed, elected or otherwise holding a governance role in an education context."@en ; gov:status "Provisional"@en ; gov:legislation <https://www.legislation.gov.uk/uksi/2012/1034/contents>, <https://www.legislation.gov.uk/ukpga/2002/32/section/19> ; rdfs:seeAlso <https://dfe-digital.github.io/education-provider-registry-docs/models/governance/vocabulary/references/#governor> .
gov:GovernorType a skos:Concept ; skos:inScheme gov:governanceVocabulary ; skos:prefLabel "Governor type"@en ; skos:definition "A classification describing the type or route of a governor's governance role."@en ; gov:status "Provisional"@en ; gov:legislation <https://www.legislation.gov.uk/uksi/2012/1034/contents> ; rdfs:seeAlso <https://dfe-digital.github.io/education-provider-registry-docs/models/governance/vocabulary/references/#governor-type> .
gov:Governance a skos:Concept ; skos:inScheme gov:governanceVocabulary ; skos:prefLabel "Governance"@en ; skos:definition "The direction, oversight and accountability of an education organisation or governing body."@en ; gov:status "Provisional"@en ; rdfs:isDefinedBy <https://www.gov.uk/government/publications/academy-trust-handbook/academy-trust-handbook-2025-effective-from-1-september-2025>, <https://www.gov.uk/government/publications/maintained-schools-governance-guide/maintained-schools-governance-guide> ; rdfs:seeAlso <https://dfe-digital.github.io/education-provider-registry-docs/models/governance/vocabulary/references/#governance> .
gov:GovernanceProfessional a skos:Concept ; skos:inScheme gov:governanceVocabulary ; skos:prefLabel "Governance professional"@en ; skos:definition "A person providing professional procedural and governance support to a governing body or board."@en ; gov:status "Provisional"@en ; rdfs:isDefinedBy <https://www.gov.uk/government/publications/academy-trust-handbook/academy-trust-handbook-2025-effective-from-1-september-2025> ; rdfs:seeAlso <https://dfe-digital.github.io/education-provider-registry-docs/models/governance/vocabulary/references/#governance-professional> .
gov:HistoricalAppointment a skos:Concept ; skos:inScheme gov:governanceVocabulary ; skos:prefLabel "Historical appointment"@en ; skos:definition "An appointment that has ended or is retained as a record of past governance."@en ; gov:status "Provisional"@en ; rdfs:isDefinedBy <https://www.gov.uk/government/publications/academy-trust-handbook/academy-trust-handbook-2025-effective-from-1-september-2025> ; rdfs:seeAlso <https://dfe-digital.github.io/education-provider-registry-docs/models/governance/vocabulary/references/#historical-appointment> .
gov:HistoricalMember a skos:Concept ; skos:inScheme gov:governanceVocabulary ; skos:prefLabel "Historical member"@en ; skos:definition "A person retained as having held membership of a governing body in the past."@en ; gov:status "Provisional"@en ; rdfs:isDefinedBy <https://www.gov.uk/government/publications/academy-trust-handbook/academy-trust-handbook-2025-effective-from-1-september-2025> ; rdfs:seeAlso <https://dfe-digital.github.io/education-provider-registry-docs/models/governance/vocabulary/references/#historical-member> .
gov:HistoricalRecord a skos:Concept ; skos:inScheme gov:governanceVocabulary ; skos:prefLabel "Historical record"@en ; skos:definition "A record retained to describe a past governance state or event."@en ; gov:status "Provisional"@en ; rdfs:isDefinedBy <https://www.gov.uk/government/publications/academy-trust-handbook/academy-trust-handbook-2025-effective-from-1-september-2025> ; rdfs:seeAlso <https://dfe-digital.github.io/education-provider-registry-docs/models/governance/vocabulary/references/#historical-record> .
gov:InterimExecutiveBoard a skos:Concept ; skos:inScheme gov:governanceVocabulary ; skos:prefLabel "Interim Executive Board"@en ; skos:definition "A governing body consisting wholly or partly of interim executive members, established by a local authority under s.65 of the Education and Inspections Act 2006 with the Secretary of State's consent."@en ; gov:status "Provisional"@en ; gov:legislation <https://www.legislation.gov.uk/ukpga/2006/40/section/65>, <https://www.legislation.gov.uk/ukpga/2006/40/schedule/6> ; rdfs:seeAlso <https://dfe-digital.github.io/education-provider-registry-docs/models/governance/vocabulary/references/#interim-executive-board> .
gov:LocalAuthorityGovernor a skos:Concept ; skos:inScheme gov:governanceVocabulary ; skos:prefLabel "Local authority governor"@en ; skos:definition "A governor nominated or appointed through a local authority route."@en ; gov:status "Provisional"@en ; gov:legislation <https://www.legislation.gov.uk/uksi/2012/1034/regulation/8/made> ; rdfs:seeAlso <https://dfe-digital.github.io/education-provider-registry-docs/models/governance/vocabulary/references/#local-authority-governor> .
gov:LocalGoverningBody a skos:Concept ; skos:inScheme gov:governanceVocabulary ; skos:prefLabel "Local governing body"@en ; skos:definition "A governing body responsible for local governance of an academy or group of establishments."@en ; gov:status "Provisional"@en ; rdfs:isDefinedBy <https://www.gov.uk/government/publications/academy-trust-handbook/academy-trust-handbook-2025-effective-from-1-september-2025> ; rdfs:seeAlso <https://dfe-digital.github.io/education-provider-registry-docs/models/governance/vocabulary/references/#local-governing-body> .
gov:LocalGovernor a skos:Concept ; skos:inScheme gov:governanceVocabulary ; skos:prefLabel "Local governor"@en ; skos:definition "A person holding a governance role at the local governing-body level of an academy or group."@en ; gov:status "Provisional"@en ; rdfs:isDefinedBy <https://www.gov.uk/government/publications/academy-trust-handbook/academy-trust-handbook-2025-effective-from-1-september-2025> ; rdfs:seeAlso <https://dfe-digital.github.io/education-provider-registry-docs/models/governance/vocabulary/references/#local-governor> .
gov:LocalGoverningBodyMember a skos:Concept ; skos:inScheme gov:governanceVocabulary ; skos:prefLabel "Local governing body member"@en ; skos:definition "A person who is a member of a local governing body."@en ; gov:status "Provisional"@en ; rdfs:isDefinedBy <https://www.gov.uk/government/publications/academy-trust-handbook/academy-trust-handbook-2025-effective-from-1-september-2025> ; rdfs:seeAlso <https://dfe-digital.github.io/education-provider-registry-docs/models/governance/vocabulary/references/#local-governing-body-member> .
gov:Meeting a skos:Concept ; skos:inScheme gov:governanceVocabulary ; skos:prefLabel "Meeting"@en ; skos:definition "A convened activity at which a governing body, board or committee conducts governance business."@en ; gov:status "Provisional"@en ; gov:legislation <https://www.legislation.gov.uk/uksi/2013/1624/regulation/14/made> ; rdfs:seeAlso <https://dfe-digital.github.io/education-provider-registry-docs/models/governance/vocabulary/references/#meeting> .
gov:Member a skos:Concept ; skos:inScheme gov:governanceVocabulary ; skos:prefLabel "Member"@en ; skos:definition "A person or body holding membership of an organisation, board or governing body."@en ; gov:status "Provisional"@en ; rdfs:isDefinedBy <https://www.gov.uk/government/publications/academy-trust-handbook/academy-trust-handbook-2025-effective-from-1-september-2025> ; gov:legislation <https://www.legislation.gov.uk/ukpga/2006/46/section/112> ; rdfs:seeAlso <https://dfe-digital.github.io/education-provider-registry-docs/models/governance/vocabulary/references/#member> .
gov:Membership a skos:Concept ; skos:inScheme gov:governanceVocabulary ; skos:prefLabel "Membership"@en ; skos:definition "The relationship by which a person or body belongs to an organisation, board or governing body."@en ; gov:status "Provisional"@en ; rdfs:isDefinedBy <https://www.gov.uk/government/publications/academy-trust-handbook/academy-trust-handbook-2025-effective-from-1-september-2025> ; gov:legislation <https://www.legislation.gov.uk/ukpga/2006/46/section/112> ; rdfs:seeAlso <https://dfe-digital.github.io/education-provider-registry-docs/models/governance/vocabulary/references/#membership> .
gov:Noticeboard a skos:Concept ; skos:inScheme gov:governanceVocabulary ; skos:prefLabel "Noticeboard"@en ; skos:definition "A shared governance communication space for publishing notices or updates."@en ; gov:status "Provisional"@en ; rdfs:isDefinedBy <https://help.governorhub.com/en/> ; rdfs:seeAlso <https://dfe-digital.github.io/education-provider-registry-docs/models/governance/vocabulary/references/#noticeboard> .
gov:OfficeHolder a skos:Concept ; skos:inScheme gov:governanceVocabulary ; skos:prefLabel "Office-holder"@en ; skos:definition "A person holding a named office or responsibility within a governing body or organisation."@en ; gov:status "Provisional"@en ; gov:legislation <https://www.legislation.gov.uk/ukpga/2006/46/section/1173> ; rdfs:seeAlso <https://dfe-digital.github.io/education-provider-registry-docs/models/governance/vocabulary/references/#office-holder> .
gov:ParentGovernor a skos:Concept ; skos:inScheme gov:governanceVocabulary ; skos:prefLabel "Parent governor"@en ; skos:definition "A governor elected or appointed to represent parents or carers."@en ; gov:status "Provisional"@en ; gov:legislation <https://www.legislation.gov.uk/uksi/2012/1034/regulation/6/made> ; rdfs:seeAlso <https://dfe-digital.github.io/education-provider-registry-docs/models/governance/vocabulary/references/#parent-governor> .
gov:PartnershipGovernor a skos:Concept ; skos:inScheme gov:governanceVocabulary ; skos:prefLabel "Partnership governor"@en ; skos:definition "A governor appointed following nomination by a qualifying business or community partner, or - where the school has a religious character - appointed for the purpose of preserving and developing that character."@en ; gov:status "Provisional"@en ; gov:legislation <https://www.legislation.gov.uk/uksi/2012/1034/regulation/10/made> ; rdfs:seeAlso <https://dfe-digital.github.io/education-provider-registry-docs/models/governance/vocabulary/references/#partnership-governor> .
gov:Principal a skos:Concept ; skos:inScheme gov:governanceVocabulary ; skos:prefLabel "Principal"@en ; skos:definition "The senior executive leader of an academy or other education establishment."@en ; gov:status "Provisional"@en ; rdfs:isDefinedBy <https://www.gov.uk/government/publications/academy-trust-handbook/academy-trust-handbook-2025-effective-from-1-september-2025> ; rdfs:seeAlso <https://dfe-digital.github.io/education-provider-registry-docs/models/governance/vocabulary/references/#principal> .
gov:Role a skos:Concept ; skos:inScheme gov:governanceVocabulary ; skos:prefLabel "Role"@en ; skos:definition "A defined responsibility or capacity held by a person or body in a governance context."@en ; gov:status "Provisional"@en ; rdfs:isDefinedBy <https://www.gov.uk/government/publications/academy-trust-handbook/academy-trust-handbook-2025-effective-from-1-september-2025> ; rdfs:seeAlso <https://dfe-digital.github.io/education-provider-registry-docs/models/governance/vocabulary/references/#role> .
gov:RoleAssignment a skos:Concept ; skos:inScheme gov:governanceVocabulary ; skos:prefLabel "Role assignment"@en ; skos:definition "The association of a person or body with a governance role for a period or purpose."@en ; gov:status "Provisional"@en ; rdfs:isDefinedBy <https://www.gov.uk/government/publications/academy-trust-handbook/academy-trust-handbook-2025-effective-from-1-september-2025> ; rdfs:seeAlso <https://dfe-digital.github.io/education-provider-registry-docs/models/governance/vocabulary/references/#role-assignment> .
gov:School a skos:Concept ; skos:inScheme gov:governanceVocabulary ; skos:prefLabel "School"@en ; skos:definition "An education establishment providing schooling and subject to a governance arrangement."@en ; gov:status "Provisional"@en ; rdfs:isDefinedBy <https://www.gov.uk/types-of-school> ; gov:legislation <https://www.legislation.gov.uk/ukpga/1996/56/section/4> ; rdfs:seeAlso <https://dfe-digital.github.io/education-provider-registry-docs/models/governance/vocabulary/references/#school> .
gov:StaffGovernor a skos:Concept ; skos:inScheme gov:governanceVocabulary ; skos:prefLabel "Staff governor"@en ; skos:definition "A governor elected or appointed to represent staff at an establishment."@en ; gov:status "Provisional"@en ; gov:legislation <https://www.legislation.gov.uk/uksi/2012/1034/regulation/7/made> ; rdfs:seeAlso <https://dfe-digital.github.io/education-provider-registry-docs/models/governance/vocabulary/references/#staff-governor> .
gov:TermOfOffice a skos:Concept ; skos:inScheme gov:governanceVocabulary ; skos:prefLabel "Term of office"@en ; skos:definition "The period during which a person holds a governance appointment or office."@en ; gov:status "Provisional"@en ; gov:legislation <https://www.legislation.gov.uk/uksi/2012/1034/regulation/18/made> ; rdfs:seeAlso <https://dfe-digital.github.io/education-provider-registry-docs/models/governance/vocabulary/references/#term-of-office> .
gov:Training a skos:Concept ; skos:inScheme gov:governanceVocabulary ; skos:prefLabel "Training"@en ; skos:definition "Learning undertaken to develop governance knowledge, skills or assurance."@en ; gov:status "Provisional"@en ; rdfs:isDefinedBy <https://www.gov.uk/government/publications/academy-trust-handbook/academy-trust-handbook-2025-effective-from-1-september-2025> ; rdfs:seeAlso <https://dfe-digital.github.io/education-provider-registry-docs/models/governance/vocabulary/references/#training> .
gov:TrainingRecord a skos:Concept ; skos:inScheme gov:governanceVocabulary ; skos:prefLabel "Training record"@en ; skos:definition "A record of governance training undertaken or assigned to a person."@en ; gov:status "Provisional"@en ; rdfs:isDefinedBy <https://help.governorhub.com/en/> ; rdfs:seeAlso <https://dfe-digital.github.io/education-provider-registry-docs/models/governance/vocabulary/references/#training-record> .
gov:Trustee a skos:Concept ; skos:inScheme gov:governanceVocabulary ; skos:prefLabel "Trustee"@en ; skos:definition "A person responsible for governing and holding fiduciary duties for a trust."@en ; gov:status "Provisional"@en ; rdfs:isDefinedBy <https://www.gov.uk/government/publications/academy-trust-handbook/academy-trust-handbook-2025-effective-from-1-september-2025> ; gov:legislation <https://www.legislation.gov.uk/ukpga/2011/25/section/177> ; rdfs:seeAlso <https://dfe-digital.github.io/education-provider-registry-docs/models/governance/vocabulary/references/#trustee> .
gov:TrustBoard a skos:Concept ; skos:inScheme gov:governanceVocabulary ; skos:prefLabel "Trust board"@en ; skos:definition "The board responsible for governing a trust."@en ; gov:status "Provisional"@en ; rdfs:isDefinedBy <https://www.gov.uk/government/publications/academy-trust-handbook/academy-trust-handbook-2025-effective-from-1-september-2025>, <https://www.gov.uk/government/publications/academy-trust-governance-guide> ; rdfs:seeAlso <https://dfe-digital.github.io/education-provider-registry-docs/models/governance/vocabulary/references/#trust-board> .
gov:TrustMember a skos:Concept ; skos:inScheme gov:governanceVocabulary ; skos:prefLabel "Trust member"@en ; skos:definition "A person or body holding membership of a trust."@en ; gov:status "Provisional"@en ; rdfs:isDefinedBy <https://www.gov.uk/government/publications/academy-trust-handbook/academy-trust-handbook-2025-effective-from-1-september-2025> ; gov:legislation <https://www.legislation.gov.uk/ukpga/2006/46/section/112> ; rdfs:seeAlso <https://dfe-digital.github.io/education-provider-registry-docs/models/governance/vocabulary/references/#trust-member> .
gov:Vacancy a skos:Concept ; skos:inScheme gov:governanceVocabulary ; skos:prefLabel "Vacancy"@en ; skos:definition "An unoccupied constitution position or governance role."@en ; gov:status "Provisional"@en ; gov:legislation <https://www.legislation.gov.uk/uksi/2012/1034/schedule/1/made> ; rdfs:seeAlso <https://dfe-digital.github.io/education-provider-registry-docs/models/governance/vocabulary/references/#vacancy> .
gov:ViceChair a skos:Concept ; skos:inScheme gov:governanceVocabulary ; skos:prefLabel "Vice chair"@en ; skos:definition "The office-holder who deputises for or supports a chair."@en ; gov:status "Provisional"@en ; gov:legislation <https://www.legislation.gov.uk/uksi/2013/1624/regulation/7/made> ; rdfs:seeAlso <https://dfe-digital.github.io/education-provider-registry-docs/models/governance/vocabulary/references/#vice-chair> .
