#################################################################
# GOVERNANCE TAB
# Governance section visible for 23 of 41 types (observed June 2026).
# Closed establishments may show legal-duty section only (no row data).
# "Shared with" field visible only for academy types with shared roles.
#################################################################

# Governance-tab tracking entities. These are this file's own bookkeeping
# subjects (UI-coverage is about GIAS screen fields, not ontology semantics),
# not vocabulary concepts themselves - each names the real concept that
# defines its meaning via est:vocabularyConcept, which may be a gov: term
# since governance appointments are modelled by the governance model, not
# this one. See establishment-governance-overlap-removal-plan.md.

est:GovernanceTabPersonField
    est:shownOnTab est:governanceTab ;
    est:uiLabel "Name"@en ;
    est:vocabularyConcept gov:GovernancePerson ;
    est:applicableToEstablishmentType
        "01", "02", "03", "05", "06", "07", "12", "14", "15",
        "28", "33", "34", "35", "36", "38", "39", "40", "41",
        "42", "43", "44", "45", "46" .

